<script>
  (function () {
    const backBtn = document.getElementById("navBackBtn");
    if (!backBtn) return;

    function getSavedLeadsUrl() {
      try {
        return sessionStorage.getItem("leadsLastUrl");
      } catch {
        return null;
      }
    }

    function pickFallback() {
      try {
        const ref = document.referrer;
        if (ref && new URL(ref).origin === location.origin) {
          return ref;
        }
      } catch {}

      return getSavedLeadsUrl() || "/leads";
    }

    function smartBack() {
      try {
        if (history.length > 1 && document.referrer.includes(location.origin)) {
          history.back();
          return;
        }
        location.href = pickFallback();
      } catch {
        location.href = "/leads";
      }
    }

    document.addEventListener("DOMContentLoaded", () => {
      backBtn.href = pickFallback(); // enables long-press open-in-new-tab
      backBtn.addEventListener("click", (e) => {
        e.preventDefault();
        smartBack();
      });
    });
  })();
</script>

<!-- GLOBAL NOTIFICATION AUDIO & TOAST CONTAINER -->
<audio id="crmNotificationAudio" src="/sounds/notification.wav" preload="auto"></audio>
<div 
  id="crmNotificationContainer" 
  class="toast-container position-fixed top-0 end-0 p-3" 
  style="z-index: 99999; max-width: 380px; width: 100%; pointer-events: none;"
></div>

<style>
  .crm-notif-toast {
    border-left: 4px solid #25D366 !important;
    background: #ffffff;
    box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.15);
    border-radius: 8px;
    animation: crmSlideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes crmSlideIn {
    from {
      opacity: 0;
      transform: translateX(100%);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>

<script src="/socket.io/socket.io.js"></script>
<script>
  (function() {
    // 1. Shared Socket.IO connection across all pages
    if (typeof io !== 'undefined') {
      window.__crmSocket = window.__crmSocket || io();
    }

    // 2. Audio Engine with Dual Unlocking (HTML5 Audio + Web Audio API)
    // Ensures reliable sound playback on computers, tablets, and mobile phones
    let audioUnlocked = false;

    function getAudioContext() {
      try {
        if (!window.__crmAudioCtx) {
          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          if (AudioContextClass) window.__crmAudioCtx = new AudioContextClass();
        }
        if (window.__crmAudioCtx && window.__crmAudioCtx.state === 'suspended') {
          window.__crmAudioCtx.resume();
        }
      } catch (e) {}
      return window.__crmAudioCtx;
    }

    // Unlocks browser audio autoplay restrictions on user's first touch or click
    function unlockAudio() {
      if (audioUnlocked) return;

      // 1. Warm up HTML5 audio element
      const audioEl = document.getElementById('crmNotificationAudio');
      if (audioEl) {
        audioEl.volume = 0.001;
        const playPromise = audioEl.play();
        if (playPromise !== undefined) {
          playPromise.then(() => {
            audioEl.pause();
            audioEl.currentTime = 0;
            audioEl.volume = 1.0;
            audioUnlocked = true;
          }).catch(() => {});
        }
      }

      // 2. Warm up Web Audio context with a silent buffer
      try {
        const ctx = getAudioContext();
        if (ctx) {
          if (ctx.state === 'suspended') ctx.resume();
          const buffer = ctx.createBuffer(1, 1, 22050);
          const source = ctx.createBufferSource();
          source.buffer = buffer;
          source.connect(ctx.destination);
          source.start(0);
          audioUnlocked = true;
        }
      } catch (e) {}

      // 3. Request desktop/mobile notification permission on first interaction
      if (typeof Notification !== 'undefined' && Notification.permission === 'default') {
        try {
          Notification.requestPermission().catch(() => {});
        } catch (e) {}
      }
    }

    window.addEventListener('click', unlockAudio, { capture: true, passive: true });
    window.addEventListener('touchstart', unlockAudio, { capture: true, passive: true });
    window.addEventListener('keydown', unlockAudio, { capture: true, passive: true });

    // Iconic WhatsApp mobile "pop-ting" incoming message sound
    function playSynthesizedChime() {
      try {
        const ctx = getAudioContext();
        if (!ctx) return;
        if (ctx.state === 'suspended') ctx.resume();

        const now = ctx.currentTime;

        // 1. Initial soft "pop" (A5 ~880 Hz)
        const osc1 = ctx.createOscillator();
        const gain1 = ctx.createGain();
        osc1.type = 'sine';
        osc1.frequency.setValueAtTime(880.0, now);

        gain1.gain.setValueAtTime(0, now);
        gain1.gain.linearRampToValueAtTime(0.35, now + 0.003);
        gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.09);

        osc1.connect(gain1);
        gain1.connect(ctx.destination);
        osc1.start(now);
        osc1.stop(now + 0.09);

        // 2. High crystal "ting" (A6 ~1760 Hz) - the signature WhatsApp message chime
        const osc2 = ctx.createOscillator();
        const gain2 = ctx.createGain();
        osc2.type = 'sine';
        osc2.frequency.setValueAtTime(1760.0, now + 0.055);

        gain2.gain.setValueAtTime(0, now + 0.055);
        gain2.gain.linearRampToValueAtTime(0.45, now + 0.058);
        gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.36);

        osc2.connect(gain2);
        gain2.connect(ctx.destination);
        osc2.start(now + 0.055);
        osc2.stop(now + 0.36);

        // 3. Subtle high sparkle overtone (A7 ~3520 Hz)
        const osc3 = ctx.createOscillator();
        const gain3 = ctx.createGain();
        osc3.type = 'sine';
        osc3.frequency.setValueAtTime(3520.0, now + 0.055);

        gain3.gain.setValueAtTime(0, now + 0.055);
        gain3.gain.linearRampToValueAtTime(0.12, now + 0.058);
        gain3.gain.exponentialRampToValueAtTime(0.001, now + 0.28);

        osc3.connect(gain3);
        gain3.connect(ctx.destination);
        osc3.start(now + 0.055);
        osc3.stop(now + 0.28);
      } catch (err) {
        console.warn('Synthesized chime error:', err);
      }
    }

    // Primary audio playback: plays notification audio with fallback to synthesizer
    function playNotificationSound() {
      const audioEl = document.getElementById('crmNotificationAudio');
      if (audioEl) {
        try {
          audioEl.currentTime = 0;
          audioEl.volume = 1.0;
          const playPromise = audioEl.play();
          if (playPromise !== undefined) {
            playPromise.catch((err) => {
              console.warn('HTML5 audio play blocked, falling back to Web Audio:', err);
              playSynthesizedChime();
            });
          }
        } catch (e) {
          playSynthesizedChime();
        }
      } else {
        playSynthesizedChime();
      }
    }

    // Expose globally for detail and chat views
    window.playCrmNotificationSound = playNotificationSound;

    // 3. Desktop / Mobile Browser System Notification
    function showBrowserNotification(data) {
      if (typeof Notification !== 'undefined' && Notification.permission === 'granted') {
        try {
          const title = `Message from ${data.customerName || 'Lead'}`;
          const notif = new Notification(title, {
            body: data.message || 'Incoming WhatsApp message',
            icon: '/images/logo.png',
            tag: `lead-${data.leadId}`,
            renotify: true
          });
          notif.onclick = () => {
            window.focus();
            window.location.href = `/leads/${data.leadId}`;
          };
        } catch (e) {
          console.warn('Browser notification error:', e);
        }
      }
    }

    // 4. In-App Floating Toast Notification
    function escapeHtml(str) {
      if (!str) return '';
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    function showInAppToast(data) {
      const container = document.getElementById('crmNotificationContainer');
      if (!container) return;

      const toastEl = document.createElement('div');
      toastEl.className = 'toast show border-0 crm-notif-toast mb-2';
      toastEl.setAttribute('role', 'alert');
      toastEl.setAttribute('aria-live', 'assertive');
      toastEl.setAttribute('aria-atomic', 'true');
      toastEl.style.pointerEvents = 'auto';

      toastEl.innerHTML = `
        <div class="toast-header bg-white border-0 pb-1 d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success rounded-circle p-1 d-inline-flex align-items-center justify-content-center" style="width: 22px; height: 22px;">
              <i class="bi bi-whatsapp text-white" style="font-size: 11px;"></i>
            </span>
            <strong class="text-dark text-truncate" style="max-width: 200px;">${escapeHtml(data.customerName || 'Lead')}</strong>
          </div>
          <div class="d-flex align-items-center gap-1">
            <small class="text-muted" style="font-size: 0.72rem;">Just now</small>
            <button type="button" class="btn-close small" aria-label="Close" style="font-size: 0.65rem;"></button>
          </div>
        </div>
        <div class="toast-body pt-1" style="cursor: pointer;">
          ${data.contactNumber ? `<div class="text-muted small mb-1" style="font-size: 0.75rem;">${escapeHtml(data.contactNumber)}</div>` : ''}
          <div class="text-dark fw-medium" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 0.88rem;">
            ${escapeHtml(data.message || 'New message')}
          </div>
          <div class="mt-2 text-primary small fw-semibold d-flex align-items-center" style="font-size: 0.78rem;">
            <span>Reply in Chat</span> <i class="bi bi-arrow-right-short fs-6"></i>
          </div>
        </div>
      `;

      // Close button
      const closeBtn = toastEl.querySelector('.btn-close');
      if (closeBtn) {
        closeBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          toastEl.remove();
        });
      }

      // Click body to navigate to lead chat
      const body = toastEl.querySelector('.toast-body');
      if (body) {
        body.addEventListener('click', () => {
          window.location.href = `/leads/${data.leadId}`;
        });
      }

      container.appendChild(toastEl);

      // Auto dismiss after 7 seconds
      setTimeout(() => {
        if (toastEl.parentNode) {
          toastEl.style.opacity = '0';
          toastEl.style.transition = 'opacity 0.4s ease';
          setTimeout(() => toastEl.remove(), 400);
        }
      }, 7000);
    }

    // 5. Connect and listen for notifications
    document.addEventListener('DOMContentLoaded', () => {
      if (window.__crmSocket) {
        window.__crmSocket.on('leadMessageNotification', (data) => {
          console.log('🔔 Inbound lead message notification:', data);

          // Always play notification sound alert!
          playNotificationSound();

          // Trigger browser desktop / mobile notification
          showBrowserNotification(data);

          // If current tab is NOT already viewing this lead, show toast popup!
          if (!window.__activeLeadId || String(window.__activeLeadId) !== String(data.leadId)) {
            showInAppToast(data);
          }
        });
      }
    });
  })();
</script>
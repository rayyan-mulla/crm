<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Payment Detail - <%= payment.paymentNumber || payment._id %> - Olive Chairs ERP</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>

<body>

<%- include('../partials/navbar', { user, activePage }) %>

<%
  const formatDate = (value, includeTime = false) => {
    if (!value) return '-';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '-';

    return date.toLocaleString('en-IN', {
      timeZone: 'Asia/Kolkata',
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
      ...(includeTime ? {
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: true
      } : {})
    }).replace(' am', ' AM').replace(' pm', ' PM');
  };
%>

<div class="container py-5">

  <!-- HEADER & AUDIT CARD -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
          <h4 class="mb-1"><%= payment.paymentNumber || 'Payment Details' %></h4>
          <div class="text-muted small">Vendor Payment Details</div>
        </div>

        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-success">
            Payment
          </span>
        </div>
      </div>

      <div class="row g-3 mt-2">
        <div class="col-md-3">
          <small class="text-muted d-block mb-1">Created By</small>
          <div><%= payment.createdBy?.fullName || payment.createdBy?.name || '-' %></div>
        </div>

        <div class="col-md-3">
          <small class="text-muted d-block mb-1">Created At</small>
          <div><%= formatDate(payment.createdAt, true) %></div>
        </div>

        <div class="col-md-3">
          <small class="text-muted d-block mb-1">Updated By</small>
          <div><%= payment.updatedBy?.fullName || payment.updatedBy?.name || '-' %></div>
        </div>

        <div class="col-md-3">
          <small class="text-muted d-block mb-1">Updated At</small>
          <div><%= formatDate(payment.updatedAt, true) %></div>
        </div>
      </div>

      <hr>

      <!-- DETAILS -->
      <div class="row g-3 align-items-start">
        <div class="col-12 col-sm-6 col-lg-3">
          <small class="text-muted d-block mb-1">Vendor</small>
          <div class="fw-semibold"><%= payment.vendor?.name || '-' %></div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
          <small class="text-muted d-block mb-1">Amount Paid</small>
          <div class="fw-bold text-success fs-5">
            ₹<%= Number(payment.amount).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
          </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-2">
          <small class="text-muted d-block mb-1">Payment Date</small>
          <div><%= formatDate(payment.paymentDate) %></div>
        </div>

        <div class="col-12 col-sm-6 col-lg-2">
          <small class="text-muted d-block mb-1">Payment Method</small>
          <div class="text-capitalize"><%= payment.paymentMethod || '-' %></div>
        </div>

        <div class="col-12 col-sm-6 col-lg-2">
          <small class="text-muted d-block mb-1">Reference / UTR / Cheque</small>
          <div><%= payment.reference || '-' %></div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
          <small class="text-muted d-block mb-1">Bill / Invoice No.</small>
          <div>
            <% if (payment.billNumber) { %>
              <strong class="text-primary"><%= payment.billNumber %></strong>
            <% } else { %>
              <span class="text-muted">General / On Account</span>
            <% } %>
          </div>
        </div>

        <% if (payment.purchaseOrder) { %>
          <div class="col-12 col-sm-6 col-lg-3">
            <small class="text-muted d-block mb-1">Purchase Order</small>
            <div>
              <a href="/purchasing/purchase-orders/<%= payment.purchaseOrder._id %>" class="fw-semibold text-decoration-none">
                <%= payment.purchaseOrder.purchaseNumber %> <i class="bi bi-box-arrow-up-right ms-1"></i>
              </a>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- NOTES -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <h5 class="mb-3">Payment Notes</h5>
      <% if (payment.notes) { %>
        <div class="border rounded p-3 bg-light"><%= payment.notes %></div>
      <% } else { %>
        <p class="text-muted mb-0">No notes added.</p>
      <% } %>
    </div>
  </div>

  <!-- ACTIONS -->
  <div class="d-flex justify-content-end gap-2">
    <a href="/purchasing/vendor-payments" class="btn btn-secondary me-2">Back to Payments</a>
    <a href="/purchasing/vendor-payments/<%= payment._id %>/edit" class="btn btn-primary">Edit Payment</a>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Vendor Payments - Olive Chairs ERP</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <style>
    .sticky-actions {
      position: sticky;
      top: 0;
      z-index: 1020;
      background: #fff;
      padding: .5rem 0;
    }

    .sticky-pagination {
      position: sticky;
      bottom: 0;
      z-index: 1010;
      background: #fff;
      padding: .5rem 0;
    }
  </style>
</head>

<body>

<%- include('../partials/navbar', { user, activePage }) %>

<%
  const formatDate = (value) => {
    if (!value) return '-';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '-';

    return date.toLocaleDateString('en-IN', {
      timeZone: 'Asia/Kolkata',
      day: '2-digit',
      month: '2-digit',
      year: 'numeric'
    });
  };
%>

<div class="container py-5">

  <!-- PAGE HEADER -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Vendor Payments</h3>
    <a href="/purchasing/vendor-payments/new<%= selectedVendor ? '?vendor=' + selectedVendor : '' %>" class="btn btn-outline-primary">
      + Add Payment
    </a>
  </div>

  <!-- SUMMARY CARDS -->
  <%
    const totalBilled = bills.reduce((s, b) => s + Number(b.billAmount || 0), 0);
  %>

  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <div class="text-muted small">Total Billed</div>
          <div class="fs-4 fw-bold text-dark mt-1">
            ₹<%= totalBilled.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
          </div>
          <div class="text-muted small mt-1"><%= bills.length %> bill(s) recorded</div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <div class="text-muted small">Total Payments</div>
          <div class="fs-4 fw-bold text-success mt-1">
            ₹<%= totalPaymentsAmount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
          </div>
          <div class="text-muted small mt-1"><%= paymentsCount || 0 %> payment(s) made</div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <div class="text-muted small"><%= currentVendor ? currentVendor.name + ' Balance' : 'Outstanding Balance' %></div>
          <div class="fs-4 fw-bold <%= vendorBalance > 0 ? 'text-danger' : (vendorBalance < 0 ? 'text-success' : 'text-secondary') %> mt-1">
            ₹<%= vendorBalance.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
          </div>
          <div class="text-muted small mt-1"><%= bills.filter(b => b.pendingAmount > 0).length %> bill(s) pending</div>
        </div>
      </div>
    </div>
  </div>

  <!-- FILTER BAR -->
  <div class="sticky-actions d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <!-- Vendor Filter -->
    <form method="get" class="d-flex align-items-center gap-2">
      <input type="hidden" name="tab" value="<%= activeTab %>">
      <span class="small text-muted">Vendor:</span>
      <select name="vendor" class="form-select form-select-sm" style="width: auto; min-width: 220px;" onchange="this.form.submit()">
        <option value="">All Vendors</option>
        <% vendors.forEach(v => { %>
          <option value="<%= v._id %>" <%= String(selectedVendor) === String(v._id) ? 'selected' : '' %>>
            <%= v.name %> (₹<%= (v.balance || 0).toFixed(2) %>)
          </option>
        <% }) %>
      </select>
      <% if (selectedVendor) { %>
        <a href="/purchasing/vendor-payments?tab=<%= activeTab %>" class="btn btn-sm btn-outline-secondary" title="Clear filter">
          <i class="bi bi-x-lg"></i>
        </a>
      <% } %>
    </form>

    <!-- Search -->
    <form method="get" class="d-flex gap-2">
      <input type="hidden" name="tab" value="<%= activeTab %>">
      <% if (selectedVendor) { %>
        <input type="hidden" name="vendor" value="<%= selectedVendor %>">
      <% } %>
      <input name="search" class="form-control form-control-sm" placeholder="Search bill / PO / ref..." value="<%= query.search || '' %>" style="width: 220px;">
      <button class="btn btn-sm btn-primary">Search</button>
    </form>
  </div>

  <!-- TABS -->
  <ul class="nav nav-tabs mb-3">
    <li class="nav-item">
      <a class="nav-link <%= activeTab === 'bills' ? 'active fw-semibold' : '' %>" href="?tab=bills<%= selectedVendor ? '&vendor=' + selectedVendor : '' %>">
        Payable Bills
        <span class="badge <%= bills.filter(b => b.pendingAmount > 0).length ? 'bg-danger' : 'bg-secondary' %> ms-1">
          <%= bills.length %>
        </span>
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= activeTab === 'payments' ? 'active fw-semibold' : '' %>" href="?tab=payments<%= selectedVendor ? '&vendor=' + selectedVendor : '' %>">
        Payments
        <span class="badge bg-secondary ms-1"><%= paymentsCount || 0 %></span>
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= activeTab === 'ledger' ? 'active fw-semibold' : '' %>" href="?tab=ledger<%= selectedVendor ? '&vendor=' + selectedVendor : '' %>">
        Ledger History
        <span class="badge bg-secondary ms-1"><%= ledger.length %></span>
      </a>
    </li>
  </ul>

  <!-- TAB CONTENT -->
  <% if (activeTab === 'bills') { %>
    <!-- BILLS TABLE -->
    <div class="card shadow-sm">
      <div class="card-body">
        <% if (!bills.length) { %>
          <p class="text-muted text-center mb-0 py-3">No bills found.</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
              <thead class="table-light">
                <tr>
                  <th>#</th>
                  <th>Bill / Inv No.</th>
                  <th>PO Number</th>
                  <th>Date</th>
                  <th>Vendor</th>
                  <th>Type</th>
                  <th class="text-end">Bill Amount</th>
                  <th class="text-end">Paid</th>
                  <th class="text-end">Balance Due</th>
                  <th class="text-center">Status</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% bills.forEach((b, idx) => { %>
                  <tr>
                    <td><%= idx + 1 %></td>
                    <td>
                      <strong><%= b.billNumber %></strong>
                    </td>
                    <td>
                      <a href="/purchasing/purchase-orders/<%= b.purchaseOrderId %>" class="text-decoration-none">
                        <%= b.poNumber %>
                      </a>
                    </td>
                    <td class="text-nowrap"><%= formatDate(b.billDate) %></td>
                    <td><%= b.vendorName %></td>
                    <td>
                      <span class="badge <%= b.type === 'Service Bill' ? 'bg-info text-white' : 'bg-secondary' %>">
                        <%= b.type %>
                      </span>
                    </td>
                    <td class="text-end">
                      ₹<%= Number(b.billAmount).toFixed(2) %>
                    </td>
                    <td class="text-end text-success">
                      ₹<%= Number(b.paidAmount).toFixed(2) %>
                    </td>
                    <td class="text-end fw-bold <%= b.pendingAmount > 0 ? 'text-danger' : 'text-muted' %>">
                      ₹<%= Number(b.pendingAmount).toFixed(2) %>
                    </td>
                    <td class="text-center">
                      <span class="badge <%= b.status === 'PAID' ? 'bg-success' : (b.status === 'PARTIAL' ? 'bg-warning' : 'bg-danger') %>">
                        <%= b.status === 'PAID' ? 'Paid' : (b.status === 'PARTIAL' ? 'Partial' : 'Unpaid') %>
                      </span>
                    </td>
                    <td class="text-end">
                      <% if (b.pendingAmount > 0) { %>
                        <a href="/purchasing/vendor-payments/new?vendor=<%= b.vendorId %>&po=<%= b.purchaseOrderId %>&receipt=<%= b.receiptIndex %>&bill=<%= encodeURIComponent(b.billNumber) %>" class="btn btn-sm btn-outline-success">
                          Pay Bill
                        </a>
                      <% } %>
                      <a href="/purchasing/purchase-orders/<%= b.purchaseOrderId %>" class="btn btn-sm btn-outline-info ms-1">
                        View PO
                      </a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>

  <% } else if (activeTab === 'payments') { %>
    <!-- PAYMENTS TABLE -->
    <div class="card shadow-sm">
      <div class="card-body">
        <% if (!payments || !payments.length) { %>
          <p class="text-muted text-center mb-0 py-3">No payments recorded.</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
              <thead class="table-light">
                <tr>
                  <th>#</th>
                  <th>Payment No.</th>
                  <th>Date</th>
                  <th>Vendor</th>
                  <th>Against Bill / PO</th>
                  <th>Method</th>
                  <th>Reference</th>
                  <th class="text-end">Amount Paid</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% payments.forEach((p, idx) => { %>
                  <tr>
                    <td><%= idx + 1 %></td>
                    <td>
                      <strong><%= p.paymentNumber || '-' %></strong>
                    </td>
                    <td class="text-nowrap"><%= formatDate(p.paymentDate) %></td>
                    <td><%= p.vendor?.name || '-' %></td>
                    <td>
                      <% if (p.billNumber) { %>
                        <strong class="text-primary"><%= p.billNumber %></strong>
                        <% if (p.purchaseOrder) { %>
                          <small class="text-muted d-block">(PO: <%= p.purchaseOrder.purchaseNumber %>)</small>
                        <% } %>
                      <% } else if (p.purchaseOrder) { %>
                        <a href="/purchasing/purchase-orders/<%= p.purchaseOrder._id %>" class="text-decoration-none">
                          <%= p.purchaseOrder.purchaseNumber %>
                        </a>
                      <% } else { %>
                        <span class="text-muted">On Account</span>
                      <% } %>
                    </td>
                    <td class="text-capitalize"><%= p.paymentMethod || 'cash' %></td>
                    <td><%= p.reference || '-' %></td>
                    <td class="text-end fw-bold text-success">
                      ₹<%= Number(p.amount).toFixed(2) %>
                    </td>
                    <td class="text-end">
                      <a href="/purchasing/vendor-payments/<%= p._id %>" class="btn btn-sm btn-outline-info">View</a>
                      <a href="/purchasing/vendor-payments/<%= p._id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>
                      <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="<%= p._id %>" data-name="<%= p.paymentNumber || p.reference || 'Payment' %>">
                        Delete
                      </button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>

  <% } else { %>

    <!-- LEDGER TABLE -->
    <div class="card shadow-sm">
      <div class="card-body">
        <% if (!ledger.length) { %>
          <p class="text-muted text-center mb-0 py-3">No transactions found.</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
              <thead class="table-light">
                <tr>
                  <th>Date</th>
                  <th>Type</th>
                  <th>Vendor</th>
                  <th>Ref / Bill No.</th>
                  <th>PO Number</th>
                  <th class="text-end">Debit</th>
                  <th class="text-end">Credit</th>
                  <th class="text-end">Running Balance</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% ledger.forEach(l => { %>
                  <tr>
                    <td class="text-nowrap"><%= formatDate(l.date) %></td>
                    <td>
                      <span class="badge <%= l.source === 'payment' ? 'bg-success' : (l.source === 'settlement' ? 'bg-secondary' : 'bg-primary') %>">
                        <%= l.type %>
                      </span>
                    </td>
                    <td><%= l.vendor %></td>
                    <td><strong><%= l.ref %></strong></td>
                    <td>
                      <% if (l.poNumber && l.poNumber !== '-') { %>
                        <a href="/purchasing/purchase-orders/<%= l.id %>" class="text-decoration-none">
                          <%= l.poNumber %>
                        </a>
                      <% } else { %>
                        -
                      <% } %>
                    </td>
                    <td class="text-end text-danger">
                      <%= l.debit ? '₹' + Number(l.debit).toFixed(2) : '-' %>
                    </td>
                    <td class="text-end text-success">
                      <%= l.credit ? '₹' + Number(l.credit).toFixed(2) : '-' %>
                    </td>
                    <td class="text-end fw-bold <%= l.balance > 0 ? 'text-danger' : (l.balance < 0 ? 'text-success' : 'text-secondary') %>">
                      ₹<%= Number(l.balance).toFixed(2) %>
                    </td>
                    <td class="text-end">
                      <% if (l.source === 'payment') { %>
                        <a href="/purchasing/vendor-payments/<%= l.id %>" class="btn btn-sm btn-outline-info">View</a>
                        <a href="/purchasing/vendor-payments/<%= l.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>
                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="<%= l.id %>" data-name="<%= l.ref %>">
                          Delete
                        </button>
                      <% } else if (l.source === 'bill') { %>
                        <a href="/purchasing/purchase-orders/<%= l.id %>" class="btn btn-sm btn-outline-info">View PO</a>
                      <% } else { %>
                        -
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>

</div>

<!-- DELETE MODAL -->
<div class="modal fade" id="deleteModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form id="deleteForm" method="POST">
        <div class="modal-header">
          <h5 class="modal-title">Confirm Delete Payment</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
          <p>
            Are you sure you want to delete payment <strong id="deleteName"></strong>?
          </p>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger">Yes, Delete</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  const deleteModal = document.getElementById('deleteModal');
  const deleteForm = document.getElementById('deleteForm');
  const deleteName = document.getElementById('deleteName');

  if (deleteModal) {
    deleteModal.addEventListener('show.bs.modal', event => {
      const button = event.relatedTarget;
      const id = button.getAttribute('data-id');
      const name = button.getAttribute('data-name');

      deleteForm.action = `/purchasing/vendor-payments/${id}/delete`;
      deleteName.textContent = name;
    });
  }
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
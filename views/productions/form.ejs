<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= mode === 'edit' ? 'Edit Production' : 'Add Production' %> - Olive Chairs ERP</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

  <style>
    .remove-row { cursor: pointer; }
    .item-card { background: #fafafa; }
  </style>
</head>
<body>
<%- include('../partials/navbar', { user, activePage }) %>

<div class="container py-5">
  <h3 class="mb-4">
    <%= mode === 'edit' ? 'Edit Production' : 'New Production' %>
  </h3>

  <form method="POST" action="<%= mode === 'edit' ? '/production/productions/' + production._id : '/production/productions' %>">

    <div class="card shadow-sm p-3 mb-4">
      <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Production Details</h5>
      </div>
      <div class="card-body">
        <div class="row g-3">
          
          <div class="col-md-3">
            <label class="form-label">Production Date</label>
            <input type="date" name="date" class="form-control"
              value="<%= production ? new Date(production.date).toISOString().split('T')[0] : new Date().toISOString().split('T')[0] %>" required>
          </div>

          <div class="col-md-3">
              <label class="form-label">Production Type</label>
              <select name="type" class="form-select" required>
                  <option value="Regular" <%= production?.type === 'Regular' ? 'selected' : '' %>>Regular</option>
                  <option value="Sample" <%= production?.type === 'Sample' ? 'selected' : '' %>>Sample</option>
                  <option value="Rework" <%= production?.type === 'Rework' ? 'selected' : '' %>>Rework</option>
              </select>
          </div>

          <div class="col-md-3">
              <label class="form-label">Production Supervisor</label>
              <select name="supervisor" class="form-select" required>
                  <option value="">Select Supervisor</option>

                  <% supervisors.forEach(supervisor => { %>
                      <option
                          value="<%= supervisor._id %>"
                          <%= production?.supervisor?._id?.toString() === supervisor._id.toString() ? 'selected' : '' %>>
                          <%= supervisor.fullName %>
                      </option>
                  <% }) %>
              </select>
          </div>

          <div class="col-md-3">
            <label class="form-label">Status</label>
            <select name="status" class="form-select">
              <option value="COMPLETED" <%= production?.status === 'COMPLETED' ? 'selected' : '' %>>Completed</option>
              <option value="DRAFT" <%= production?.status === 'DRAFT' ? 'selected' : '' %>>Draft</option>
              <option value="CANCELLED" <%= production?.status === 'CANCELLED' ? 'selected' : '' %>>Cancelled</option>
            </select>
          </div>

        </div>
      </div>
    </div>

    <div class="card shadow-sm p-3">
      <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Production Items</h5>
        <button type="button" class="btn btn-outline-primary btn-sm" id="addRow">+ Add Item</button>
      </div>

      <div class="card-body">
        <div id="itemsContainer">
          <% const itemsData = production?.items?.length ? production.items : [{}]; %>
          <% itemsData.forEach((item, index) => { %>
            
            <div class="item-card border rounded p-3 mb-3">
              <div class="row g-3 align-items-end">
                
                <div class="col-md-3">
                  <label class="form-label">Type</label>
                  <select class="form-select itemType" name="items[<%= index %>][itemType]">
                    <option value="SubAssembly" <%= item.itemType === 'SubAssembly' ? 'selected' : '' %>>Sub-Assembly</option>
                    <option value="Chair" <%= item.itemType === 'Chair' ? 'selected' : '' %>>Chair</option>
                  </select>
                </div>

                <div class="col-md-6 subAssemblyWrapper <%= item.itemType === 'Chair' ? 'd-none' : '' %>">
                  <label class="form-label">Item</label>
                  <select class="form-select subAssemblySelect" name="items[<%= index %>][subAssembly]">
                    <option value="">Select Sub-Assembly</option>
                    <% subAssemblies.forEach(sa => { %>
                      <option value="<%= sa._id %>" <%= item.subAssembly?.toString() === sa._id.toString() ? 'selected' : '' %>><%= sa.name %></option>
                    <% }) %>
                  </select>
                </div>

                <div class="col-md-3 chairWrapper <%= item.itemType === 'Chair' ? '' : 'd-none' %>">
                  <label class="form-label">Item</label>
                  <select class="form-select chairSelect" name="items[<%= index %>][chair]">
                    <option value="">Select Chair</option>
                    <% chairs.forEach(c => { %>
                      <option value="<%= c._id %>" data-colors='<%- JSON.stringify(c.colors || []) %>' <%= item.chair?.toString() === c._id.toString() ? 'selected' : '' %>><%= c.modelName %></option>
                    <% }) %>
                  </select>
                </div>

                <div class="col-md-3 colorWrapper <%= item.itemType === 'Chair' ? '' : 'd-none' %>">
                  <label class="form-label">Color</label>
                  <select class="form-select colorSelect" name="items[<%= index %>][chairColor]">
                    <option value="">Select Color</option>
                  </select>
                </div>

                <div class="col-md-2">
                  <label class="form-label">Qty</label>
                  <input type="number" name="items[<%= index %>][quantityTarget]" class="form-control qty" value="<%= item.quantityTarget || 1 %>" min="1" required>
                </div>

                <div class="col-md-1 text-end">
                  <button type="button" class="btn btn-outline-danger remove-row">✕</button>
                </div>

              </div>
            </div>

          <% }) %>
        </div>
      </div>
    </div>

    <div class="card shadow-sm p-3 mt-4">
      <div class="card-body">
        <label class="form-label">Notes</label>
        <textarea name="notes" class="form-control" rows="3"><%= production?.notes || '' %></textarea>
      </div>
    </div>

    <div class="text-end mt-4">
      <button type="submit" class="btn btn-primary">Save Production</button>
    </div>
  </form>
</div>

<script>
  let rowIndex = <%= itemsData.length %>;
  const chairs = <%- JSON.stringify(chairs) %>;

  /* HANDLE TYPE LAYOUT BALANCING */
  document.addEventListener('change', function(e) {
    const row = e.target.closest('.item-card');
    if (!row) return;

    if (e.target.classList.contains('itemType')) {
      const subWrap = row.querySelector('.subAssemblyWrapper');
      const chairWrap = row.querySelector('.chairWrapper');
      const colorWrap = row.querySelector('.colorWrapper');
      const colorSelect = row.querySelector('.colorSelect');
      const subSelect = row.querySelector('.subAssemblySelect');
      const chairSelect = row.querySelector('.chairSelect');

      colorSelect.innerHTML = '<option value="">Select Color</option>';
      subSelect.value = '';
      chairSelect.value = '';

      if (e.target.value === 'Chair') {
        subWrap.classList.add('d-none');
        chairWrap.classList.remove('d-none');
        colorWrap.classList.remove('d-none');
      } else {
        subWrap.classList.remove('d-none');
        chairWrap.classList.add('d-none');
        colorWrap.classList.add('d-none');
      }
    }

    /* POPULATE CHAIR VARIANT DYNAMICALLY */
    if (e.target.classList.contains('chairSelect')) {
      const option = e.target.selectedOptions[0];
      const colorSelect = row.querySelector('.colorSelect');
      colorSelect.innerHTML = '<option value="">Select Color</option>';
      
      if (option && option.value) {
        const colors = JSON.parse(option.dataset.colors || "[]");
        colors.forEach(c => {
          const opt = document.createElement('option');
          opt.value = c._id;
          opt.textContent = c.name;
          colorSelect.appendChild(opt);
        });
      }
    }
  });

  /* ADD REPEATABLE ROW METHOD */
  document.getElementById('addRow').addEventListener('click', () => {
    const container = document.getElementById('itemsContainer');
    const firstRow = container.querySelector('.item-card');
    const newRow = firstRow.cloneNode(true);

    newRow.querySelectorAll('input, select').forEach(el => {
      if (el.name) {
        el.name = el.name.replace(/\[\d+\]/, `[${rowIndex}]`);
      }
      if (el.tagName === "SELECT") {
        el.selectedIndex = 0;
      } else {
        el.value = '';
      }
    });

    newRow.querySelector('.qty').value = 1;

    newRow.querySelector('.subAssemblyWrapper').classList.remove('d-none');
    newRow.querySelector('.chairWrapper').classList.add('d-none');
    newRow.querySelector('.colorWrapper').classList.add('d-none');
    newRow.querySelector('.colorSelect').innerHTML = '<option value="">Select Color</option>';

    container.appendChild(newRow);
    rowIndex++;
  });

  /* REMOVE SELECTED LINE ROW METHOD */
  document.addEventListener('click', function(e) {
    if (e.target.classList.contains('remove-row')) {
      const rows = document.querySelectorAll('.item-card');
      if (rows.length > 1) {
        e.target.closest('.item-card').remove();
      }
    }
  });

  /* REHYDRATION SETUP FOR EDIT TRIPS */
  document.addEventListener('DOMContentLoaded', () => {
    <% if (mode === 'edit' && production?.items) { %>
      const savedItems = <%- JSON.stringify(production.items) %>;
      document.querySelectorAll('.item-card').forEach((row, idx) => {
        const item = savedItems[idx];
        if (!item) return;

        if (item.itemType === 'Chair' && item.chair) {
          const chairSelect = row.querySelector('.chairSelect');
          const colorSelect = row.querySelector('.colorSelect');
          
          const selectedChair = chairs.find(c => c._id === item.chair);
          if (selectedChair && selectedChair.colors) {
            colorSelect.innerHTML = '<option value="">Select Color</option>';
            selectedChair.colors.forEach(c => {
              const opt = document.createElement('option');
              opt.value = c._id;
              opt.textContent = c.name;
              if (item.chairColor && c._id.toString() === item.chairColor.toString()) {
                opt.selected = true;
              }
              colorSelect.appendChild(opt);
            });
          }
        }
      });
    <% } %>
  });
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
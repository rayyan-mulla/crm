<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Edit Tax Invoice - <%= invoice.invoiceNumber %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <style>
    .pi-section {
      background: #f8f9fa;
      border-radius: 8px;
      padding: 16px;
    }
    .remove-row { cursor: pointer; }
    .item-card { background: #fafafa; }
  </style>
</head>

<body>
<%- include('../partials/navbar', { user, activePage }) %>

<div class="container py-4">

  <h3 class="mb-3">
    Edit Tax Invoice
    <small class="text-muted fs-6">
      <%= invoice.invoiceNumber %> — <%= lead.customer_name %>
    </small>
  </h3>

  <form
    action="/leads/<%= lead._id %>/pi/<%= invoice.piId %>/invoices/<%= invoice._id %>/edit"
    method="post"
    class="card shadow-sm p-4"
  >

    <!-- ================= BILLING ADDRESS ================= -->
    <div class="pi-section mb-4">
      <h5 class="mb-3">Billing Address</h5>

      <div class="row g-3">

        <div class="col-md-6 col-lg-3">
          <label class="form-label">Billing Name</label>
          <input class="form-control" name="billing[name]"
                 value="<%= invoice.billingAddress?.name || '' %>" required>
        </div>

        <div class="col-md-6 col-lg-3">
          <label class="form-label">Email Address</label>
          <input
            type="email"
            class="form-control"
            name="billing[email]"
            value="<%= invoice.billingAddress?.email || '' %>"
          >
        </div>

        <div class="col-md-6 col-lg-3">
          <label class="form-label">Phone Number</label>
          <input class="form-control" name="billing[phone]"
                 value="<%= invoice.billingAddress?.phone || '' %>"
                 pattern="[0-9]{10}">
        </div>

        <div class="col-md-6 col-lg-3">
          <label class="form-label">GSTIN</label>
          <input class="form-control" name="billing[gstin]"
                 value="<%= invoice.billingAddress?.gstin || '' %>">
        </div>

        <div class="col-12">
          <label class="form-label">Address Line</label>
          <input class="form-control" name="billing[line1]"
                 value="<%= invoice.billingAddress?.line1 || '' %>" required>
        </div>

        <div class="col-md-4">
          <label class="form-label">City</label>
          <input class="form-control" name="billing[city]"
                 value="<%= invoice.billingAddress?.city || '' %>" required>
        </div>

        <div class="col-md-4">
          <label class="form-label">State</label>
          <input class="form-control" name="billing[state]"
                 value="<%= invoice.billingAddress?.state || '' %>" required>
        </div>

        <div class="col-md-4">
          <label class="form-label">Pincode</label>
          <input class="form-control" name="billing[pincode]"
                 value="<%= invoice.billingAddress?.pincode || '' %>">
        </div>

      </div>
    </div>

    <!-- ================= SAME AS BILLING ================= -->
    <div class="form-check mb-4">
      <input class="form-check-input"
             type="checkbox"
             id="sameAsBilling"
             name="sameAsBilling"
             value="true"
             <%= invoice.shippingAddress?.line1 === invoice.billingAddress?.line1 ? 'checked' : '' %>>
      <label class="form-check-label">
        Shipping address same as billing
      </label>
    </div>

    <!-- ================= SHIPPING ADDRESS ================= -->
    <div class="pi-section mb-4" id="shippingSection">
      <h5 class="mb-3">Shipping Address</h5>

      <div class="row g-3">

        <div class="col-md-6">
          <label class="form-label">Shipping Name</label>
          <input class="form-control" name="shipping[name]"
                 value="<%= invoice.shippingAddress?.name || '' %>" required>
        </div>

        <div class="col-md-6">
          <label class="form-label">Phone Number</label>
          <input class="form-control" name="shipping[phone]"
                 value="<%= invoice.shippingAddress?.phone || '' %>"
                 pattern="[0-9]{10}">
        </div>

        <div class="col-12">
          <label class="form-label">Address Line</label>
          <input class="form-control" name="shipping[line1]"
                 value="<%= invoice.shippingAddress?.line1 || '' %>" required>
        </div>

        <div class="col-md-4">
          <label class="form-label">City</label>
          <input class="form-control" name="shipping[city]"
                 value="<%= invoice.shippingAddress?.city || '' %>" required>
        </div>

        <div class="col-md-4">
          <label class="form-label">State</label>
          <input class="form-control" name="shipping[state]"
                 value="<%= invoice.shippingAddress?.state || '' %>" required>
        </div>

        <div class="col-md-4">
          <label class="form-label">Pincode</label>
          <input class="form-control" name="shipping[pincode]"
                 value="<%= invoice.shippingAddress?.pincode || '' %>">
        </div>

      </div>
    </div>

    <!-- ================= ITEMS CARD ================= -->
    <div class="card shadow-sm p-3 mb-4">
      <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Requirement Items</h5>
        <button type="button" class="btn btn-outline-primary btn-sm" id="addRow">+ Add Item</button>
      </div>

      <div class="card-body">
        <div id="itemsContainer">
          <% const itemsData = invoice.items && invoice.items.length ? invoice.items : [{}]; %>
          <% itemsData.forEach((item, index) => { %>
            <% 
              const itemType = item.itemType || 'Chair';
              const selectedItemId = (
                item.chairId?._id || item.chairId ||
                item.sparePart?._id || item.sparePart ||
                item.subAssembly?._id || item.subAssembly ||
                item.item?._id || item.item
              )?.toString() || '';
            %>
            <div class="item-card border rounded p-3 mb-3">
              <input type="hidden" name="items[<%= index %>][itemId]" value="<%= item._id || '' %>">

              <div class="row g-2 align-items-end">

                <!-- Type Selection -->
                <div class="col-md-2">
                  <label class="form-label">Type</label>
                  <select class="form-select itemType" name="items[<%= index %>][itemType]">
                    <option value="SubAssembly" <%= itemType === 'SubAssembly' ? 'selected' : '' %>>Sub-Assembly</option>
                    <option value="Chair" <%= itemType === 'Chair' ? 'selected' : '' %>>Chair</option>
                    <option value="SparePart" <%= (itemType === 'SparePart' || itemType === 'Spare Part') ? 'selected' : '' %>>Spare Part</option>
                  </select>
                </div>

                <!-- Sub-Assembly / Spare Part Select Wrapper -->
                <div class="col-md-4 subAssemblyWrapper <%= itemType === 'Chair' ? 'd-none' : '' %>">
                  <label class="form-label itemSelectLabel">
                    <%= (itemType === 'SparePart' || itemType === 'Spare Part') ? 'Spare Part' : 'Sub-Assembly' %>
                  </label>
                  <select class="form-select subAssemblySelect" name="items[<%= index %>][subAssembly]" data-selected="<%= selectedItemId %>">
                    <option value="">Select Item</option>
                  </select>
                </div>

                <!-- Chair Select Wrapper -->
                <div class="col-md-2 chairWrapper <%= itemType === 'Chair' ? '' : 'd-none' %>">
                  <label class="form-label">Item</label>
                  <select class="form-select chairSelect" name="items[<%= index %>][chair]" data-selected="<%= selectedItemId %>">
                    <option value="">Select Chair</option>
                  </select>
                </div>

                <!-- Color Select Wrapper -->
                <div class="col-md-2 colorWrapper <%= itemType === 'Chair' ? '' : 'd-none' %>">
                  <label class="form-label">Color</label>
                  <select class="form-select colorSelect" name="items[<%= index %>][colorId]" data-selected="<%= item.colorId || item.chairColor || '' %>">
                    <option value="">Select Color</option>
                  </select>
                </div>

                <!-- Quantity Input -->
                <div class="col-md-1">
                  <label class="form-label">Qty</label>
                  <input type="number" name="items[<%= index %>][quantity]" class="form-control qty" value="<%= item.quantity || 1 %>" min="1" required>
                </div>

                <!-- Unit Price -->
                <div class="col-md-2">
                  <label class="form-label">Unit Price (₹)</label>
                  <input type="number" name="items[<%= index %>][unitPrice]" class="form-control unitPrice" value="<%= item.unitPrice || 0 %>" placeholder="0" step="0.01" required>
                </div>

                <!-- Shipping Price -->
                <div class="col-md-1">
                  <label class="form-label">Shipping</label>
                  <input type="number" name="items[<%= index %>][shippingUnit]" class="form-control shippingUnit" value="<%= item.shippingUnit || 0 %>" placeholder="0" step="0.01">
                </div>

                <!-- Total Price Field -->
                <div class="col-md-1">
                  <label class="form-label">Total</label>
                  <input type="text" name="items[<%= index %>][totalPrice]" class="form-control totalPrice bg-white" value="<%= (item.quantity || 1) * ((item.unitPrice || 0) + (item.shippingUnit || 0)) %>" readonly>
                </div>

                <!-- Remove Row Button -->
                <div class="col-md-1 text-end">
                  <button type="button" class="btn btn-outline-danger remove-row">✕</button>
                </div>

              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- ================= GST & OPTIONS ================= -->
    <div class="pi-section mb-4">
      <h5 class="mb-3">GST & Invoice Options</h5>

      <div class="form-check mb-3">
        <input class="form-check-input"
               type="checkbox"
               name="gstEnabled"
               value="true"
               <%= invoice.gstEnabled ? 'checked' : '' %>>
        <label class="form-check-label">GST Applicable</label>
      </div>

      <div class="row g-3">

        <!-- PO Number Field -->
        <div class="col-md-3">
          <label class="form-label">PO Number</label>
          <input class="form-control"
                 name="poNumber"
                 value="<%= invoice.poNumber || '' %>">
        </div>

        <div class="col-md-3">
          <label class="form-label">Payment Mode</label>
          <select name="paymentMode" class="form-select">
            <option value="">-- Select --</option>
            <% ['NEFT / RTGS','Cheque','UPI','Cash'].forEach(m => { %>
              <option value="<%= m %>" <%= invoice.paymentMode === m ? 'selected' : '' %>>
                <%= m %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-3">
          <label class="form-label">Estimated Delivery</label>
          <input class="form-control"
                 name="estimatedDelivery"
                 value="<%= invoice.estimatedDelivery || '' %>">
        </div>

        <div class="col-md-3">
          <label class="form-label">Installation</label>
          <select name="installationType" class="form-select">
            <option value="FREE" <%= invoice.installationType === 'FREE' ? 'selected' : '' %>>
              Free Installation
            </option>
            <option value="DIY" <%= invoice.installationType === 'DIY' ? 'selected' : '' %>>
              DIY (Do It Yourself)
            </option>
          </select>
        </div>
      </div>

      <div class="mt-3">
        <label class="form-label">Notes (shown on Invoice)</label>
        <textarea name="notes" class="form-control" rows="3"><%= invoice.notes || '' %></textarea>
      </div>
    </div>

    <!-- ================= ACTIONS ================= -->
    <div class="d-flex justify-content-end">
      <a href="/leads/<%= lead._id %>/pi/<%= invoice.piId %>/invoices" class="btn btn-secondary me-2">
        Cancel
      </a>
      <button class="btn btn-primary">
        Update Tax Invoice
      </button>
    </div>

  </form>
</div>

<!-- ================= JAVASCRIPT ================= -->
<script>
  // Shipping section toggle
  const sameChk = document.getElementById('sameAsBilling');
  const shippingSection = document.getElementById('shippingSection');

  function toggleShipping() {
    const inputs = shippingSection.querySelectorAll('input');
    if (sameChk.checked) {
      shippingSection.style.display = 'none';
      inputs.forEach(i => i.disabled = true);
    } else {
      shippingSection.style.display = 'block';
      inputs.forEach(i => i.disabled = false);
    }
  }

  sameChk.addEventListener('change', toggleShipping);
  toggleShipping();
</script>

<script>
  let rowIndex = <%= itemsData.length %>;

  // Pass catalog datasets into JS
  const chairs = <%- JSON.stringify(chairs || []) %>;
  const subAssemblies = <%- JSON.stringify(subAssemblies || []) %>;
  const spareParts = <%- JSON.stringify(spareParts || []) %>;

  /* CALCULATE TOTAL PRICE FOR ROW */
  function calculateRowTotal(row) {
    const qty = parseInt(row.querySelector('.qty')?.value) || 0;
    const unitPrice = parseFloat(row.querySelector('.unitPrice')?.value) || 0;
    const shippingUnit = parseFloat(row.querySelector('.shippingUnit')?.value) || 0;

    const lineTotal = Math.round(unitPrice * qty);

    const totalInput = row.querySelector('.totalPrice');
    if (totalInput) totalInput.value = lineTotal;
  }

  /* HELPER TO POPULATE COLOR OPTIONS FOR A CHAIR */
  function populateColors(row, chairId, selectedColorId = null) {
    const colorSelect = row.querySelector('.colorSelect');
    if (!colorSelect) return;

    colorSelect.innerHTML = '<option value="">Select Color</option>';
    if (!chairId) return;

    const selectedChair = chairs.find(c => String(c._id) === String(chairId));
    if (selectedChair && selectedChair.colors) {
      selectedChair.colors.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c._id;
        const price = c.basePrice || c.price || 0;
        opt.dataset.basePrice = price;
        opt.textContent = price ? `${c.name} (₹${price})` : c.name;
        
        if (selectedColorId && String(c._id) === String(selectedColorId)) {
          opt.selected = true;
        }
        colorSelect.appendChild(opt);
      });
    }
  }

  /* POPULATE CHAIR CATALOG DROPDOWN */
  function populateChairs(row, selectedChairId = null) {
    const chairSelect = row.querySelector('.chairSelect');
    if (!chairSelect) return;

    chairSelect.innerHTML = '<option value="">Select Chair</option>';
    chairs.forEach(c => {
      const opt = document.createElement('option');
      opt.value = c._id;
      opt.textContent = c.modelName;
      if (selectedChairId && String(c._id) === String(selectedChairId)) {
        opt.selected = true;
      }
      chairSelect.appendChild(opt);
    });
  }

  /* POPULATE SUB-ASSEMBLY OR SPARE PART OPTIONS */
  function populateNonChairItems(row, itemType, selectedId = null) {
    const subSelect = row.querySelector('.subAssemblySelect');
    const label = row.querySelector('.itemSelectLabel');
    if (!subSelect) return;

    const isSpare = (itemType === 'SparePart' || itemType === 'Spare Part');
    const catalogList = isSpare ? spareParts : subAssemblies;

    if (label) label.textContent = isSpare ? 'Spare Part' : 'Sub-Assembly';

    subSelect.innerHTML = `<option value="">Select ${isSpare ? 'Spare Part' : 'Sub-Assembly'}</option>`;

    catalogList.forEach(opt => {
      const optionEl = document.createElement('option');
      const displayName = opt.partName || opt.name || 'Unnamed Item';
      const displayPrice = opt.baseCost || opt.basePrice || opt.finalCost || opt.price || 0;

      optionEl.value = opt._id;
      optionEl.dataset.price = displayPrice;
      optionEl.textContent = `${displayName} ${displayPrice ? '(₹' + displayPrice + ')' : ''}`;

      if (selectedId && String(opt._id) === String(selectedId)) {
        optionEl.selected = true;
      }
      subSelect.appendChild(optionEl);
    });
  }

  /* HANDLE TYPE LAYOUT BALANCING */
  document.addEventListener('change', function(e) {
    const row = e.target.closest('.item-card');
    if (!row) return;

    if (e.target.classList.contains('itemType')) {
      const subWrap = row.querySelector('.subAssemblyWrapper');
      const chairWrap = row.querySelector('.chairWrapper');
      const colorWrap = row.querySelector('.colorWrapper');
      const colorSelect = row.querySelector('.colorSelect');
      const chairSelect = row.querySelector('.chairSelect');

      colorSelect.innerHTML = '<option value="">Select Color</option>';
      if (chairSelect) chairSelect.value = '';

      const selectedType = e.target.value;

      if (selectedType === 'Chair') {
        subWrap.classList.add('d-none');
        chairWrap.classList.remove('d-none');
        colorWrap.classList.remove('d-none');
        populateChairs(row);
      } else {
        subWrap.classList.remove('d-none');
        chairWrap.classList.add('d-none');
        colorWrap.classList.add('d-none');
        populateNonChairItems(row, selectedType);
      }
    }

    if (e.target.classList.contains('chairSelect')) {
      populateColors(row, e.target.value);
    }

    if (e.target.classList.contains('colorSelect')) {
      const selectedOption = e.target.selectedOptions[0];
      if (selectedOption && selectedOption.dataset.basePrice) {
        row.querySelector('.unitPrice').value = selectedOption.dataset.basePrice;
        calculateRowTotal(row);
      }
    }

    if (e.target.classList.contains('subAssemblySelect')) {
      const selectedOption = e.target.selectedOptions[0];
      if (selectedOption && selectedOption.dataset.price) {
        row.querySelector('.unitPrice').value = selectedOption.dataset.price;
        calculateRowTotal(row);
      }
    }
  });

  /* RECALCULATE TOTAL ON INPUT CHANGES */
  document.addEventListener('input', function(e) {
    const row = e.target.closest('.item-card');
    if (row && (
      e.target.classList.contains('qty') || 
      e.target.classList.contains('unitPrice') ||
      e.target.classList.contains('shippingUnit')
    )) {
      calculateRowTotal(row);
    }
  });

  /* ADD REPEATABLE ROW METHOD */
  document.getElementById('addRow').addEventListener('click', () => {
    const container = document.getElementById('itemsContainer');
    const firstRow = container.querySelector('.item-card');
    const newRow = firstRow.cloneNode(true);

    newRow.querySelectorAll('input, select').forEach(el => {
      if (el.name) {
        el.name = el.name.replace(/\[\d+\]/, `[${rowIndex}]`);
      }
      if (el.tagName === "SELECT") {
        el.selectedIndex = 0;
        el.removeAttribute('data-selected');
      } else if (el.type === "hidden") {
        el.value = '';
      } else {
        el.value = '';
      }
    });

    newRow.querySelector('.qty').value = 1;
    newRow.querySelector('.unitPrice').value = 0;
    newRow.querySelector('.shippingUnit').value = 0;
    newRow.querySelector('.totalPrice').value = '0';

    newRow.querySelector('.subAssemblyWrapper').classList.remove('d-none');
    newRow.querySelector('.chairWrapper').classList.add('d-none');
    newRow.querySelector('.colorWrapper').classList.add('d-none');

    container.appendChild(newRow);
    populateNonChairItems(newRow, 'SubAssembly');
    rowIndex++;
  });

  /* REMOVE SELECTED LINE ROW METHOD */
  document.addEventListener('click', function(e) {
    if (e.target.classList.contains('remove-row')) {
      const rows = document.querySelectorAll('.item-card');
      if (rows.length > 1) {
        e.target.closest('.item-card').remove();
      } else {
        alert('At least one item is required on the Tax Invoice.');
      }
    }
  });

  /* REHYDRATION SETUP ON PAGE LOAD */
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.item-card').forEach((row) => {
      const itemTypeSelect = row.querySelector('.itemType');
      const itemType = itemTypeSelect ? itemTypeSelect.value : 'Chair';

      const chairSelect = row.querySelector('.chairSelect');
      const subSelect = row.querySelector('.subAssemblySelect');
      const colorSelect = row.querySelector('.colorSelect');

      const targetItemId = chairSelect?.getAttribute('data-selected') || subSelect?.getAttribute('data-selected');
      const selectedColorId = colorSelect?.getAttribute('data-selected');

      if (itemType === 'Chair') {
        populateChairs(row, targetItemId);
        populateColors(row, targetItemId, selectedColorId);
      } else {
        populateNonChairItems(row, itemType, targetItemId);
      }

      calculateRowTotal(row);
    });
  });
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
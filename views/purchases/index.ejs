<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Purchases - Olive Chairs ERP</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <style>
    .sticky-actions {
      position: sticky;
      top: 0;
      z-index: 1020;
      background: #fff;
      padding: .5rem 0;
    }

    .sticky-pagination {
      position: sticky;
      bottom: 0;
      z-index: 1010;
      background: #fff;
      padding: .5rem 0;
    }

    .btn-outline-purple {
      color: #6f42c1;
      border-color: #6f42c1;
    }

    .btn-outline-purple:hover {
      background-color: #6f42c1;
      color: #fff;
    }

    .btn-outline-purple.disabled,
    .btn-outline-purple:disabled {
      color: #6f42c1 !important;
      border-color: #6f42c1 !important;
      background-color: transparent !important;
      opacity: 0.5;
      pointer-events: none;
    }

    .btn-outline-info:hover {
      color: #fff !important;
    }
  </style>
</head>

<body>

<%- include('../partials/navbar', { user, activePage }) %>

<div class="container py-5">

  <!-- HEADER -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Purchases</h3>
    <a href="/purchasing/purchases/new" class="btn btn-outline-primary">
      + Add Purchase
    </a>
  </div>

  <!-- FILTER BAR -->
  <div class="sticky-actions d-flex justify-content-between align-items-center mb-3">

    <!-- PER PAGE -->
    <form class="d-flex align-items-center gap-2" method="get">
      <span class="small">Per page</span>
      <input type="hidden" name="search" value="<%= query.search || '' %>">
      <input type="hidden" name="page" value="1">
      <select name="limit" class="form-select form-select-sm" style="width:auto;min-width:80px" onchange="this.form.submit()">
        <option value="10" <%= +limit === 10 ? 'selected' : '' %>>10</option>
        <option value="25" <%= +limit === 25 ? 'selected' : '' %>>25</option>
        <option value="50" <%= +limit === 50 ? 'selected' : '' %>>50</option>
        <option value="100" <%= +limit === 100 ? 'selected' : '' %>>100</option>
      </select>
    </form>

    <!-- SEARCH -->
    <form method="get" class="d-flex gap-2">
      <input name="search" class="form-control form-control-sm" placeholder="Search purchase..." value="<%= query.search || '' %>" style="width:220px">
      <input type="hidden" name="limit" value="<%= limit %>">
      <button class="btn btn-sm btn-primary">Search</button>
    </form>

  </div>

  <div class="card shadow-sm">
    <div class="card-body">

      <!-- ERROR -->
      <% if (typeof query !== 'undefined' && query && query.error) { %>
        <div class="alert alert-danger alert-dismissible fade show mb-4">
          <i class="bi bi-exclamation-octagon-fill me-2"></i>
          <%= query.error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <% if (purchases && purchases.length > 0) { %>

        <div class="table-responsive">
          <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>#</th>
                <th>Purchase No</th>
                <th>Date</th>
                <th>Vendor</th>
                <th>Total</th>
                <th>Received</th>
                <th>Status</th>
                <th>Created By</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% purchases.forEach((p, index) => { %>
                <%
                  const hasPhysicalItems = (p.items || []).some(
                    item => item.itemType !== 'service'
                  );

                  const isFinalized =
                    (hasPhysicalItems && p.status === 'RECEIVED') ||
                    p.status === 'SHORT_CLOSED' ||
                    p.status === 'CLOSED';

                  const canReceive =
                    hasPhysicalItems &&
                    (p.status === 'ORDERED' ||
                    p.status === 'PARTIALLY_RECEIVED');
                  const receivedAmount = Number(p.receivedAmount || 0);
                  const totalAmount = Number(p.totalAmount || 0);

                  const hasReceivedQuantity = (p.receivedItems || []).some(
                    item => Number(item.receivedQuantity || 0) > 0
                  );

                  const canEdit = !isFinalized && !hasReceivedQuantity;
                  const canDelete = !hasReceivedQuantity && !isFinalized;
                %>

                <tr>
                  <td><%= (page - 1) * limit + index + 1 %></td>

                  <td>
                    <strong><%= p.purchaseNumber %></strong>
                  </td>

                  <td>
                    <%= new Date(p.purchaseDate).toLocaleDateString('en-IN', {
                      day: '2-digit',
                      month: '2-digit',
                      year: 'numeric'
                    }) %>
                  </td>

                  <td><%= p.vendor?.name || '-' %></td>

                  <td>₹<%= totalAmount.toFixed(2) %></td>

                  <td>
                    <div class="small">₹<%= receivedAmount.toFixed(2) %></div>
                    <% if (totalAmount > 0) { %>
                      <div class="progress" style="height:5px;width:100px;">
                        <div class="progress-bar" style="width: <%= Math.min(100, (receivedAmount / totalAmount) * 100) %>%;"></div>
                      </div>
                    <% } %>
                  </td>

                  <!-- STATUS -->
                  <td>
                    <span class="badge <%= p.status === 'RECEIVED'
                      ? 'bg-success'
                      : p.status === 'PARTIALLY_RECEIVED'
                      ? 'bg-warning'
                      : p.status === 'CANCELLED'
                      ? 'bg-danger'
                      : p.status === 'DRAFT'
                      ? 'bg-warning'
                      : p.status === 'ORDERED'
                      ? 'bg-info text-white'
                      : p.status === 'SHORT_CLOSED'
                      ? 'bg-secondary'
                      : p.status === 'CLOSED'
                      ? 'bg-dark'
                      : 'bg-secondary'
                    %>">
                      <%= p.status ? p.status.replace('_', ' ') : 'UNKNOWN' %>
                    </span>
                  </td>

                  <td><%= p.createdBy?.fullName || '-' %></td>

                  <!-- ACTIONS -->
                  <td class="text-end">
                    <!-- VIEW -->
                    <a href="/purchasing/purchases/<%= p._id %>" class="btn btn-sm btn-outline-info" title="View Purchase Details">
                      View
                    </a>

                    <!-- RECEIVE -->
                    <a href="/purchasing/purchases/<%= p._id %>/validate" class="btn btn-sm btn-outline-purple <%= canReceive ? '' : 'disabled' %>" title="<%= canReceive ? 'Validate Purchase' : (!hasPhysicalItems ? 'Service orders do not require validation' : 'Purchase cannot be validated') %>">
                      Validate
                    </a>

                    <!-- PDF -->
                    <a href="/purchasing/purchases/<%= p._id %>/pdf" class="btn btn-sm btn-outline-success" target="_blank" title="Download PDF">
                      PDF
                    </a>

                    <!-- EDIT -->
                    <a href="/purchasing/purchases/<%= p._id %>/edit" class="btn btn-sm btn-outline-primary <%= canEdit ? '' : 'disabled' %>" title="<%= canEdit ? 'Edit Purchase Order' : 'Purchase cannot be edited after receiving has started' %>">
                      Edit
                    </a>

                    <!-- DELETE -->
                    <button type="button" class="btn btn-sm btn-outline-danger <%= canDelete ? '' : 'disabled' %>" <%= canDelete ? '' : 'disabled' %> data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="<%= p._id %>" data-name="<%= p.purchaseNumber %>" title="<%= canDelete ? 'Delete Purchase' : 'Purchase cannot be deleted' %>">
                      Delete
                    </button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- PAGINATION -->
        <div class="sticky-pagination mt-2">
          <nav>
            <ul class="pagination justify-content-center flex-nowrap">
              <%
                function buildQuery(pageNum) {
                  let qs = `?page=${pageNum}&limit=${limit}`;
                  if (query.search) {
                    qs += `&search=${encodeURIComponent(query.search)}`;
                  }
                  return qs;
                }
              %>

              <!-- PREVIOUS -->
              <li class="page-item <%= page === 1 ? 'disabled' : '' %>">
                <a class="page-link" href="<%= buildQuery(Math.max(1, page - 1)) %>">&laquo;</a>
              </li>

              <!-- FIRST -->
              <li class="page-item <%= page === 1 ? 'active' : '' %>">
                <a class="page-link" href="<%= buildQuery(1) %>">1</a>
              </li>

              <%
                const slots = 3;
                let centerStart = page - 1;
                let centerEnd = page + 1;

                if (centerStart < 2) {
                  centerStart = 2;
                  centerEnd = centerStart + slots - 1;
                }

                if (centerEnd > totalPages - 1) {
                  centerEnd = totalPages - 1;
                  centerStart = centerEnd - slots + 1;
                }

                centerStart = Math.max(2, centerStart);
                centerEnd = Math.min(totalPages - 1, centerEnd);
              %>

              <% if (centerStart > 2) { %>
                <li class="page-item disabled">
                  <span class="page-link">…</span>
                </li>
              <% } %>

              <% for (let p = centerStart; p <= centerEnd; p++) { %>
                <li class="page-item <%= p === page ? 'active' : '' %>">
                  <a class="page-link" href="<%= buildQuery(p) %>"><%= p %></a>
                </li>
              <% } %>

              <% if (centerEnd < totalPages - 1) { %>
                <li class="page-item disabled">
                  <span class="page-link">…</span>
                </li>
              <% } %>

              <% if (totalPages > 1) { %>
                <li class="page-item <%= page === totalPages ? 'active' : '' %>">
                  <a class="page-link" href="<%= buildQuery(totalPages) %>"><%= totalPages %></a>
                </li>
              <% } %>

              <!-- NEXT -->
              <li class="page-item <%= page === totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="<%= buildQuery(totalPages) %>">&raquo;</a>
              </li>
            </ul>
          </nav>
        </div>

      <% } else { %>
        <p class="text-muted text-center mb-0">No purchases found.</p>
      <% } %>

    </div>
  </div>

</div>

<!-- DELETE MODAL -->
<div class="modal fade" id="deleteModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form id="deleteForm" method="POST">
        <div class="modal-header">
          <h5 class="modal-title">Confirm Delete</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
          <p>
            Are you sure you want to delete purchase <strong id="deleteName"></strong>?
          </p>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger">Yes, Delete</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  const deleteModal = document.getElementById('deleteModal');
  const deleteForm = document.getElementById('deleteForm');
  const deleteName = document.getElementById('deleteName');

  deleteModal.addEventListener('show.bs.modal', event => {
    const button = event.relatedTarget;
    const id = button.getAttribute('data-id');
    const name = button.getAttribute('data-name');

    deleteForm.action = `/purchasing/purchases/${id}/delete`;
    deleteName.textContent = name;
  });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>
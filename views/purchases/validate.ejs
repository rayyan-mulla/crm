<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Validate Purchase - <%= purchase.purchaseNumber %></title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

  <style>
    .receive-input {
      max-width: 120px;
    }
  </style>
</head>

<body>

<%- include('../partials/navbar', { user, activePage }) %>

<div class="container py-5">

  <!-- ERROR -->
  <div id="formErrorAlert" class="alert alert-danger alert-dismissible fade show d-none mb-4" role="alert">
    <i class="bi bi-exclamation-octagon-fill me-2"></i>
    <span id="formErrorMessage"></span>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>

  <!-- HEADER -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <div class="d-flex align-items-center gap-2">
            <h4 class="mb-0">Validate Purchase <%= purchase.purchaseNumber %></h4>
            <span class="badge <%= 
              purchase.status === 'PARTIALLY_RECEIVED'
                ? 'bg-warning'
                : purchase.status === 'ORDERED'
                ? 'bg-info text-white'
                : 'bg-secondary'
            %>">
              <%= purchase.status.replace('_', ' ') %>
            </span>
          </div>
          <div class="text-muted small mt-1">Record and validate quantities received in this delivery.</div>
        </div>

        <div>
          <button type="button" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" id="openShortCloseModalBtn">
            <i class="bi bi-x-circle"></i> Short Close
          </button>
        </div>
      </div>

      <div class="row gx-2 gy-3 mt-2">
        <div class="col-md-2">
          <small class="text-muted">Vendor</small>
          <div class="fw-semibold text-truncate"><%= purchase.vendor?.name || '-' %></div>
        </div>

        <div class="col-md-2">
          <small class="text-muted">Purchase Date</small>
          <div>
            <%= purchase.purchaseDate ? 
                new Date(purchase.purchaseDate).toLocaleDateString(
                  'en-IN', {
                    day: '2-digit',
                    month: '2-digit',
                    year: 'numeric'
                  }
                ) 
              : '-' %>
          </div>
        </div>

        <div class="col-md-2">
          <small class="text-muted">Delivery Schedule</small>
          <div><%= purchase.deliverySchedule || '-' %></div>
        </div>

        <div class="col-md-2">
          <small class="text-muted">Delivery At</small>
          <div>
            <span class="badge bg-light text-dark border"><%= purchase.deliveryAt || '-' %></span>
          </div>
        </div>

        <div class="col-md-2">
          <small class="text-muted">PO Amount</small>
          <div class="fw-bold text-success">₹<%= Number(purchase.totalAmount || 0).toFixed(2) %></div>
        </div>

        <div class="col-md-2">
          <small class="text-muted">Prev. Received</small>
          <div class="fw-bold text-success" id="headerTotalPreviouslyReceived">0</div>
        </div>
      </div>
    </div>
  </div>

  <!-- SUMMARY CARDS -->
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="text-muted small">Ordered</div>
          <div class="fs-4 fw-bold" id="totalOrdered">0</div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="text-muted small">Previously Received</div>
          <div class="fs-4 fw-bold text-success" id="totalPreviouslyReceived">0</div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="text-muted small">Remaining</div>
          <div class="fs-4 fw-bold text-warning" id="totalRemaining">0</div>
        </div>
      </div>
    </div>
  </div>

  <!-- VALIDATION FORM -->
  <form method="POST" action="/purchasing/purchases/<%= purchase._id %>/validate" id="validationForm">
    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h5 class="mb-1">Material Validation</h5>
            <div class="text-muted small">Enter only the quantity received in this delivery to validate.</div>
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-bordered table-sm align-middle">
            <thead class="table-light">
              <tr>
                <th class="text-center">#</th>
                <th>Material</th>
                <th class="text-center">Ordered</th>
                <th class="text-center">Previously Received</th>
                <th class="text-center">Remaining</th>
                <th class="text-center">Validate Now</th>
                <th class="text-center">Remaining After</th>
              </tr>
            </thead>
            <tbody>
              <% validationItems.forEach((item, index) => { %>
                <tr class="validation-row" 
                    data-ordered="<%= item.orderedQuantity %>" 
                    data-previously-received="<%= item.previouslyReceived %>" 
                    data-remaining="<%= item.remainingQuantity %>">
                  <td class="text-center"><%= index + 1 %></td>

                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <span class="fw-semibold">
                        <%= item.itemName || '-' %>
                        <% if (item.colorName) { %> - <%= item.colorName %><% } %>
                      </span>
                      <span class="badge <%= item.itemType === 'chair' ? 'bg-primary' : 'bg-secondary' %>">
                        <%= item.itemType === 'chair' ? 'Chair' : 'Spare Part' %>
                      </span>
                    </div>

                    <input type="hidden" name="items[<%= index %>][poItemIndex]" value="<%= item.poItemIndex %>">
                    <input type="hidden" name="items[<%= index %>][itemType]" value="<%= item.itemType %>">
                    <input type="hidden" name="items[<%= index %>][itemId]" value="<%= item.itemId || '' %>">
                    <input type="hidden" name="items[<%= index %>][colorId]" value="<%= item.colorId || '' %>">
                  </td>

                  <td class="text-center">
                    <strong><%= item.orderedQuantity %></strong>
                  </td>

                  <td class="text-center">
                    <span class="badge bg-success"><%= item.previouslyReceived %></span>
                  </td>

                  <td class="text-center">
                    <span class="badge bg-warning text-dark"><%= item.remainingQuantity %></span>
                  </td>

                  <td class="text-center">
                    <input type="number" 
                            class="form-control form-control-sm mx-auto receive-input received-quantity" 
                            name="items[<%= index %>][receivedQuantity]" 
                            value="0" 
                            min="0" 
                            max="<%= item.remainingQuantity %>" 
                            step="1">
                  </td>

                  <td class="text-center">
                    <span class="badge bg-secondary remaining-after"><%= item.remainingQuantity %></span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- NOTES -->
    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <h5 class="mb-3">Validation Notes</h5>
        <textarea name="validationNotes" class="form-control" rows="3" placeholder="Add details about this validation..."></textarea>
      </div>
    </div>

    <!-- ACTIONS -->
    <div class="d-flex justify-content-end gap-2">
      <button type="button" class="btn btn-primary" id="openValidateModalBtn">
        Validate Material
      </button>
    </div>
  </form>

</div>

<!-- VALIDATE CONFIRMATION MODAL -->
<div class="modal fade" id="validateModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Confirm Validation</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <div id="modalErrorAlert" class="alert alert-danger d-none">
          <span id="modalErrorMessage"></span>
        </div>

        <p class="mb-0">
          Are you sure you want to validate this delivery for
          <strong><%= purchase.purchaseNumber %></strong>?
        </p>

        <div class="alert alert-info mt-3 mb-0" id="receiptSummary"></div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="submitValidationBtn">Confirm & Save</button>
      </div>
    </div>
  </div>
</div>

<!-- SHORT CLOSE MODAL -->
<div class="modal fade" id="shortCloseModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Short Close Purchase</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <div id="shortCloseError" class="alert alert-danger d-none">
          <span id="shortCloseErrorMessage"></span>
        </div>

        <p>This action will stop further validations for this purchase.</p>

        <div class="alert alert-warning">
          Remaining quantity: <strong id="shortCloseRemaining">0</strong>
        </div>

        <label for="shortCloseReason" class="form-label">
          Reason <span class="text-danger">*</span>
        </label>
        <textarea id="shortCloseReason" class="form-control" rows="4" placeholder="Enter the reason for short closing this purchase..."></textarea>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="submitShortCloseBtn">Short Close Purchase</button>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
  const validationForm = document.getElementById('validationForm');
  const validateModal = new bootstrap.Modal(document.getElementById('validateModal'));
  const shortCloseModal = new bootstrap.Modal(document.getElementById('shortCloseModal'));

  function showFormError(message) {
    const alert = document.getElementById('formErrorAlert');
    document.getElementById('formErrorMessage').textContent = message;
    alert.classList.remove('d-none');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function updateRow(row) {
    const remaining = Number(row.dataset.remaining) || 0;
    const input = row.querySelector('.received-quantity');
    const remainingAfterElement = row.querySelector('.remaining-after');

    let receiveNow = Number(input.value) || 0;

    if (receiveNow < 0) {
      receiveNow = 0;
      input.value = 0;
    }

    if (receiveNow > remaining) {
      receiveNow = remaining;
      input.value = remaining;
    }

    const remainingAfter = remaining - receiveNow;
    remainingAfterElement.textContent = remainingAfter;

    row.classList.remove('table-success', 'table-warning');

    if (receiveNow === 0) {
      remainingAfterElement.className = 'badge remaining-after bg-secondary';
    } else if (remainingAfter === 0) {
      remainingAfterElement.className = 'badge remaining-after bg-success';
      row.classList.add('table-success');
    } else {
      remainingAfterElement.className = 'badge remaining-after bg-warning text-dark';
      row.classList.add('table-warning');
    }

    updateSummary();
  }

  function updateSummary() {
    let ordered = 0;
    let previouslyReceived = 0;
    let remaining = 0;

    document.querySelectorAll('.validation-row').forEach(row => {
      ordered += Number(row.dataset.ordered) || 0;
      previouslyReceived += Number(row.dataset.previouslyReceived) || 0;
      remaining += Number(row.dataset.remaining) || 0;
    });

    document.getElementById('totalOrdered').textContent = ordered;
    document.getElementById('totalPreviouslyReceived').textContent = previouslyReceived;
    document.getElementById('headerTotalPreviouslyReceived').textContent = previouslyReceived;
    document.getElementById('totalRemaining').textContent = remaining;
    document.getElementById('shortCloseRemaining').textContent = remaining;
  }

  document.querySelectorAll('.validation-row').forEach(row => {
    updateRow(row);
    row.querySelector('.received-quantity').addEventListener('input', () => updateRow(row));
  });

  /**
   * Open validate confirmation modal.
   */
  document.getElementById('openValidateModalBtn').addEventListener('click', () => {
    let totalReceiveNow = 0;
    let invalid = false;

    document.querySelectorAll('.validation-row').forEach(row => {
      const input = row.querySelector('.received-quantity');
      const value = Number(input.value);
      const remaining = Number(row.dataset.remaining);

      if (!Number.isFinite(value) || value < 0 || value > remaining) {
        invalid = true;
      }

      totalReceiveNow += value || 0;
    });

    if (invalid) {
      showFormError('Please enter valid quantities. You cannot validate more than the remaining quantity.');
      return;
    }

    if (totalReceiveNow <= 0) {
      showFormError('Please enter at least one quantity to validate.');
      return;
    }

    document.getElementById('receiptSummary').textContent = `You are validating ${totalReceiveNow} item(s) in this delivery.`;
    document.getElementById('modalErrorAlert').classList.add('d-none');
    validateModal.show();
  });

  /**
   * Submit validation.
   */
  document.getElementById('submitValidationBtn').addEventListener('click', async () => {
    const button = document.getElementById('submitValidationBtn');
    button.disabled = true;
    button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Processing...';

    try {
      const formData = new FormData(validationForm);
      const response = await fetch(validationForm.action, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: new URLSearchParams(formData)
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        document.getElementById('modalErrorAlert').classList.remove('d-none');
        document.getElementById('modalErrorMessage').textContent = result.message || 'Validation failed.';
        button.disabled = false;
        button.textContent = 'Confirm & Save';
        return;
      }

      window.location.href = result.redirectUrl;
    } catch (error) {
      console.error(error);
      document.getElementById('modalErrorAlert').classList.remove('d-none');
      document.getElementById('modalErrorMessage').textContent = 'A network error occurred. Please try again.';
      button.disabled = false;
      button.textContent = 'Confirm & Save';
    }
  });

  /**
   * Open short close modal.
   */
  document.getElementById('openShortCloseModalBtn').addEventListener('click', () => {
    const remaining = Number(document.getElementById('totalRemaining').textContent) || 0;

    if (remaining <= 0) {
      showFormError('This purchase is already fully validated.');
      return;
    }

    document.getElementById('shortCloseReason').value = '';
    document.getElementById('shortCloseError').classList.add('d-none');
    shortCloseModal.show();
  });

  /**
   * Submit short close.
   */
  document.getElementById('submitShortCloseBtn').addEventListener('click', async () => {
    const button = document.getElementById('submitShortCloseBtn');
    const reason = document.getElementById('shortCloseReason').value.trim();

    if (!reason) {
      document.getElementById('shortCloseError').classList.remove('d-none');
      document.getElementById('shortCloseErrorMessage').textContent = 'Please provide a reason for short closing the purchase.';
      return;
    }

    button.disabled = true;
    button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Processing...';

    try {
      const response = await fetch(`/purchasing/purchases/<%= purchase._id %>/short-close`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: new URLSearchParams({ reason })
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        document.getElementById('shortCloseError').classList.remove('d-none');
        document.getElementById('shortCloseErrorMessage').textContent = result.message || 'Failed to short close purchase.';
        button.disabled = false;
        button.textContent = 'Short Close Purchase';
        return;
      }

      window.location.href = result.redirectUrl;
    } catch (error) {
      console.error(error);
      document.getElementById('shortCloseError').classList.remove('d-none');
      document.getElementById('shortCloseErrorMessage').textContent = 'A network error occurred. Please try again.';
      button.disabled = false;
      button.textContent = 'Short Close Purchase';
    }
  });
</script>
</body>
</html>
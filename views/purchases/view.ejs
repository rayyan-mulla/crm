<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Purchase Detail - <%= purchase.purchaseNumber %></title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    .summary-card { height: 100%; }
    .summary-label { font-size: 0.8rem; color: #6c757d; }
    .summary-value { font-size: 1.25rem; font-weight: 700; }
    .receipt-header { background-color: #f8f9fa; }
    .receipt-number { font-weight: 600; }
    .table th { white-space: nowrap; }
  </style>
</head>

<body>
<%- include('../partials/navbar', { user, activePage }) %>

<%
  const money = (value) => {
    const amount = Number(value);
    return Number.isFinite(amount)
      ? amount.toLocaleString('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 2 })
      : '-';
  };

  const formatDate = (value, includeTime = false) => {
    if (!value) return '-';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '-';

    return date.toLocaleString('en-IN', {
      timeZone: 'Asia/Kolkata',
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
      ...(includeTime ? {
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: true
      } : {})
    }).replace(' am', ' AM').replace(' pm', ' PM');
  };

  const statusClass = (status) => {
    const classes = {
      DRAFT: 'bg-warning',
      ORDERED: 'bg-info',
      PARTIALLY_RECEIVED: 'bg-warning',
      RECEIVED: 'bg-success',
      CANCELLED: 'bg-danger',
      CLOSED: 'bg-dark',
      SHORT_CLOSED: 'bg-secondary'
    };
    return classes[status] || 'bg-secondary';
  };

  const validationClass = (status) => {
    if (status === 'FULLY_VALIDATED') return 'bg-success';
    if (status === 'PARTIALLY_VALIDATED') return 'bg-warning';
    return 'bg-secondary';
  };

  const getItemName = (item) => {
    if (item?.itemName) return item.itemName;
    if (item?.itemType === 'chair') return item.chair?.modelName || 'Chair';
    if (item?.itemType === 'sparePart') return item.sparePart?.partName || 'Spare Part';
    return item?.chair?.modelName || item?.sparePart?.partName || '-';
  };

  const getItemType = (item) => {
    if (item?.itemType === 'chair') return 'Chair';
    if (item?.itemType === 'sparePart') return 'Spare Part';
    return item?.itemType || '-';
  };

  const getColorName = (item) => {
    const selectedColor = item?.chairColor;
    if (!selectedColor) return '-';

    // chairColor is stored as the ID of a color in chair.colors.
    // Resolve that ID to the color name instead of displaying the ID.
    if (typeof selectedColor === 'object' && (selectedColor.name || selectedColor.colorName)) {
      return selectedColor.name || selectedColor.colorName;
    }

    const selectedColorId = selectedColor?._id?.toString?.() || selectedColor.toString();
    const colors = item?.chair?.colors || [];
    const found = colors.find(color => color?._id?.toString() === selectedColorId);

    return found?.name || found?.colorName || '-';
  };

  const getReceivedQuantity = (line) =>
    Number(line?.receivedQuantity ?? line?.quantityReceived ?? 0);

  // ReceivedPurchaseItemSchema stores the original ordered quantity
  // as orderedQuantity; PO item lines use quantity.
  const getOrderedQuantity = (line) =>
    Number(line?.orderedQuantity ?? line?.quantity ?? 0);

  const orderedItems = Array.isArray(purchase.items) ? purchase.items : [];
  const receivedLines = Array.isArray(purchase.receivedItems) ? purchase.receivedItems : [];
  const receiptHistory = Array.isArray(purchase.receiptHistory) ? purchase.receiptHistory : [];

  const totalQuantity = orderedItems.reduce((sum, item) => sum + getOrderedQuantity(item), 0);
  const totalReceivedQuantity = receivedLines.reduce((sum, item) => sum + getReceivedQuantity(item), 0);
  const hasReceivedItems = receivedLines.some(item => getReceivedQuantity(item) > 0);
  const isFinalStatus = ['RECEIVED', 'CANCELLED', 'CLOSED', 'SHORT_CLOSED'].includes(purchase.status);
  const canEdit = !isFinalStatus && !hasReceivedItems;
%>

<div class="container py-5">

  <!-- HEADER -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
          <h4 class="mb-1"><%= purchase.purchaseNumber %></h4>
          <div class="text-muted small">Purchase Order Details</div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
          <span class="badge <%= statusClass(purchase.status) %>">
            <%= purchase.status ? purchase.status.replace(/_/g, ' ') : 'UNKNOWN' %>
          </span>
          <span class="badge <%= validationClass(purchase.validationStatus) %>">
            <%= purchase.validationStatus ? purchase.validationStatus.replace(/_/g, ' ') : 'NOT VALIDATED' %>
          </span>
        </div>
      </div>

      <div class="row g-3 mt-2">
        <div class="col-md-3">
          <small class="text-muted">Created By</small>
          <div><%= purchase.createdBy?.fullName || '-' %></div>
        </div>
        <div class="col-md-3">
          <small class="text-muted">Created At</small>
          <div><%= formatDate(purchase.createdAt, true) %></div>
        </div>
        <div class="col-md-3">
          <small class="text-muted">Updated By</small>
          <div><%= purchase.updatedBy?.fullName || '-' %></div>
        </div>
        <div class="col-md-3">
          <small class="text-muted">Updated At</small>
          <div><%= formatDate(purchase.updatedAt, true) %></div>
        </div>
      </div>

      <hr>

      <div class="row g-3 align-items-start">
        <div class="col-12 col-sm-6 col-lg-3">
          <small class="text-muted d-block mb-1">Vendor</small>
          <div class="fw-semibold"><%= purchase.vendor?.name || purchase.vendor?.companyName || '-' %></div>
        </div>
        <div class="col-12 col-sm-6 col-lg-2">
          <small class="text-muted d-block mb-1">Purchase Date</small>
          <div><%= formatDate(purchase.purchaseDate) %></div>
        </div>
        <div class="col-12 col-sm-6 col-lg-2">
          <small class="text-muted d-block mb-1">Expected Delivery Date</small>
          <div><%= purchase.deliverySchedule || '-' %></div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
          <small class="text-muted d-block mb-1">Delivery Location</small>
          <div>
            <span class="badge bg-light text-dark border">
              <%= purchase.deliveryAt?.name || purchase.deliveryAt || purchase.deliveryLocation?.name || purchase.deliveryLocationName || purchase.deliveryLocation || '-' %>
            </span>
          </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-2">
          <small class="text-muted d-block mb-1">Purchase Order Value</small>
          <div class="fw-bold text-success"><%= money(purchase.totalAmount) %></div>
        </div>
      </div>
    </div>
  </div>

  <!-- SUMMARY CARDS -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card shadow-sm summary-card">
        <div class="card-body">
          <div class="summary-label">Purchase Order Value</div>
          <div class="summary-value"><%= money(purchase.totalAmount) %></div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card shadow-sm summary-card">
        <div class="card-body">
          <div class="summary-label">Received Value</div>
          <div class="summary-value text-success"><%= money(purchase.receivedAmount) %></div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card shadow-sm summary-card">
        <div class="card-body">
          <div class="summary-label">Ordered Line Items</div>
          <div class="summary-value"><%= orderedItems.length %></div>
          <small class="text-muted"><%= totalQuantity.toLocaleString('en-IN') %> units ordered</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card shadow-sm summary-card">
        <div class="card-body">
          <div class="summary-label">Received Quantity</div>
          <div class="summary-value"><%= totalReceivedQuantity.toLocaleString('en-IN') %></div>
          <small class="text-muted"><%= receiptHistory.length %> receipt(s) recorded</small>
        </div>
      </div>
    </div>
  </div>

  <!-- ORDERED ITEMS -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <h5 class="mb-3">Ordered Items</h5>

      <% if (orderedItems.length) { %>
        <div class="table-responsive">
          <table class="table table-bordered table-sm align-middle">
            <thead class="table-light">
              <tr>
                <th>Type</th>
                <th>Item</th>
                <th>Category / Details</th>
                <th>Color</th>
                <th class="text-end">Quantity</th>
                <th class="text-end">Base Price</th>
                <th class="text-end">Final Rate</th>
                <th class="text-center">GST</th>
                <th class="text-end">Line Total</th>
              </tr>
            </thead>
            <tbody>
              <% orderedItems.forEach(item => { %>
                <tr>
                  <td>
                    <span class="badge <%= item.itemType === 'chair' ? 'bg-primary' : 'bg-secondary' %>">
                      <%= getItemType(item) %>
                    </span>
                  </td>
                  <td><%= getItemName(item) %></td>
                  <td><%= item.itemType === 'sparePart' ? (item.sparePart?.category?.name || '-') : '-' %></td>
                  <td><%= item.itemType === 'chair' ? getColorName(item) : '-' %></td>
                  <td class="text-end"><%= getOrderedQuantity(item).toLocaleString('en-IN') %></td>
                  <td class="text-end"><%= money(item.basePrice) %></td>
                  <td class="text-end"><%= money(item.finalRate) %></td>
                  <td class="text-center">
                    <% if (item.gstApplicable) { %>
                      <span class="badge bg-info text-white"><%= Number(item.gstPercentage || 0) %>% GST</span>
                    <% } else { %>
                      <span class="badge bg-secondary">No GST</span>
                    <% } %>
                  </td>
                  <td class="text-end fw-bold text-success"><%= money(item.totalCost) %></td>
                </tr>
              <% }) %>
            </tbody>
            <tfoot class="table-light">
              <tr>
                <th colspan="8" class="text-end">Purchase Order Total</th>
                <th class="text-end text-success"><%= money(purchase.totalAmount) %></th>
              </tr>
            </tfoot>
          </table>
        </div>
      <% } else { %>
        <p class="text-muted mb-0">No items added to this purchase order.</p>
      <% } %>
    </div>
  </div>

  <!-- RECEIVING SUMMARY -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <h5 class="mb-3">Receiving Summary</h5>

      <% if (receivedLines.length) { %>
        <div class="table-responsive">
          <table class="table table-bordered table-sm align-middle">
            <thead class="table-light">
              <tr>
                <th>Item</th>
                <th>Type</th>
                <th class="text-end">Ordered Qty</th>
                <th class="text-end">Received Qty</th>
                <th class="text-end">Remaining Qty</th>
                <th style="min-width: 150px;">Receiving Progress</th>
                <th class="text-end">Unit Cost</th>
                <th class="text-end">Received Value</th>
                <th>Match Status</th>
              </tr>
            </thead>
            <tbody>
              <% receivedLines.forEach(line => {
                const ordered = getOrderedQuantity(line);
                const received = getReceivedQuantity(line);
                const remaining = Math.max(ordered - received, 0);
                const progress = ordered > 0 ? Math.min((received / ordered) * 100, 100) : 0;
                const matchLabel = ordered > 0 && remaining === 0 ? 'Complete' : received > 0 ? 'Partial' : 'Pending';
                const matchClass = matchLabel === 'Complete' ? 'bg-success' : matchLabel === 'Partial' ? 'bg-warning' : 'bg-secondary';
              %>
                <tr>
                  <td><%= getItemName(line) %></td>
                  <td><%= getItemType(line) %></td>
                  <td class="text-end"><%= ordered.toLocaleString('en-IN') %></td>
                  <td class="text-end fw-bold text-success"><%= received.toLocaleString('en-IN') %></td>
                  <td class="text-end"><%= remaining.toLocaleString('en-IN') %></td>
                  <td>
                    <div class="d-flex justify-content-between align-items-center gap-2 small mb-1">
                      <span class="fw-semibold"><%= Math.round(progress) %>%</span>
                      <span class="text-muted text-nowrap"><%= received.toLocaleString('en-IN') %> / <%= ordered.toLocaleString('en-IN') %> received</span>
                    </div>
                    <div class="progress" role="progressbar" aria-valuenow="<%= Math.round(progress) %>" aria-valuemin="0" aria-valuemax="100" style="height: 8px;">
                      <div class="progress-bar <%= progress >= 100 ? 'bg-success' : '' %>" style="width: <%= progress %>%"></div>
                    </div>
                  </td>
                  <td class="text-end"><%= money(line.unitCost) %></td>
                  <td class="text-end"><%= money(line.receivedValue ?? line.totalCost) %></td>
                  <td class="text-center"><span class="badge <%= matchClass %> "><%= matchLabel %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="text-muted mb-0">No receiving activity recorded yet.</p>
      <% } %>
    </div>
  </div>

  <!-- RECEIPT HISTORY -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h5 class="mb-0">Receipt History</h5>
        <span class="badge bg-secondary"><%= receiptHistory.length %> Receipt(s)</span>
      </div>

      <% if (receiptHistory.length) { %>
        <% receiptHistory.forEach((receipt, index) => { %>
          <div class="border rounded mb-4">
            <div class="receipt-header border-bottom p-3">
              <div class="row g-3 align-items-center">
                <div class="col-md-4">
                  <div class="receipt-number">Receipt <%= index + 1 %></div>
                  <div class="text-muted small">Received At</div>
                  <div><%= formatDate(receipt.receivedAt, true) %></div>
                </div>
                <div class="col-md-4">
                  <div class="text-muted small">Received By</div>
                  <div><%= receipt.receivedBy?.fullName || receipt.receivedBy?.name || '-' %></div>
                </div>
                <div class="col-md-4 text-md-end">
                  <div class="text-muted small">Receipt Value</div>
                  <div class="fw-bold fs-5"><%= money(receipt.receivedAmount) %></div>
                </div>
              </div>
            </div>

            <div class="p-3">
              <h6 class="mb-3">Items Received</h6>

              <% if (Array.isArray(receipt.items) && receipt.items.length) { %>
                <div class="table-responsive">
                  <table class="table table-bordered table-sm align-middle mb-0">
                    <thead class="table-light">
                      <tr>
                        <th>Type</th>
                        <th>Item</th>
                        <th class="text-end">Received Quantity</th>
                        <th class="text-end">Unit Cost</th>
                        <th class="text-end">Line Value</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% receipt.items.forEach(receiptItem => { %>
                        <tr>
                          <td><%= getItemType(receiptItem) %></td>
                          <td><%= getItemName(receiptItem) %></td>
                          <td class="text-end"><%= Number(receiptItem.quantityReceived ?? receiptItem.receivedQuantity ?? receiptItem.quantity ?? 0).toLocaleString('en-IN') %></td>
                          <td class="text-end"><%= money(receiptItem.unitCost) %></td>
                          <td class="text-end"><%= money(receiptItem.totalCost ?? receiptItem.receivedValue) %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } else { %>
                <p class="text-muted mb-0">No receipt line details available.</p>
              <% } %>

              <% if (receipt.notes) { %>
                <div class="mt-3">
                  <h6 class="mb-2">Receipt Notes</h6>
                  <div class="border rounded p-3 bg-light"><%= receipt.notes %></div>
                </div>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p class="text-muted mb-0">No receipts recorded yet.</p>
      <% } %>
    </div>
  </div>

  <!-- SHORT-CLOSE DETAILS -->
  <% if (purchase.status === 'SHORT_CLOSED') { %>
    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <h5 class="mb-3">Short-Close Details</h5>
        <div class="row g-3">
          <div class="col-md-4">
            <small class="text-muted">Short Closed By</small>
            <div><%= purchase.shortClosedBy?.fullName || '-' %></div>
          </div>
          <div class="col-md-4">
            <small class="text-muted">Short Closed At</small>
            <div><%= formatDate(purchase.shortClosedAt, true) %></div>
          </div>
          <div class="col-md-12">
            <small class="text-muted">Reason</small>
            <div class="border rounded p-3 bg-light"><%= purchase.shortCloseReason || 'No reason provided.' %></div>
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <!-- NOTES -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <h5 class="mb-3">Purchase Notes</h5>
      <% if (purchase.notes) { %>
        <div class="border rounded p-3 bg-light"><%= purchase.notes %></div>
      <% } else { %>
        <p class="text-muted mb-0">No notes added.</p>
      <% } %>
    </div>
  </div>

  <!-- ACTIONS -->
  <div class="d-flex justify-content-end gap-2">
    <% if (canEdit) { %>
      <a href="/purchasing/purchases/<%= purchase._id %>/edit" class="btn btn-primary">Edit Purchase</a>
    <% } else { %>
      <button type="button" class="btn btn-secondary" disabled title="Editing is unavailable after receiving starts or the purchase is finalized.">
        Edit Purchase
      </button>
    <% } %>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
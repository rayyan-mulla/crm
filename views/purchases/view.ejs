<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Purchase Detail - <%= purchase.purchaseNumber %></title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>

<body>

<%- include('../partials/navbar', { user, activePage }) %>

<div class="container py-5">

  <!-- 🔷 HEADER -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">

      <div class="d-flex justify-content-between align-items-center">
        <h4 class="mb-0">
          <%= purchase.purchaseNumber %>
        </h4>

        <!-- STATUS BADGES WITH SHORT_CLOSED AND CLOSED -->
        <span class="badge 
          <%= purchase.status === 'RECEIVED' ? 'bg-success' :
              purchase.status === 'CANCELLED' ? 'bg-danger' :
              purchase.status === 'DRAFT' ? 'bg-warning text-dark' :
              purchase.status === 'ORDERED' ? 'bg-info text-white' :
              purchase.status === 'SHORT_CLOSED' ? 'bg-secondary' :
              purchase.status === 'CLOSED' ? 'bg-dark' :
              'bg-secondary' %>">
          <%= purchase.status ? purchase.status.replace('_', ' ') : 'UNKNOWN' %>
        </span>
      </div>

      <div class="row g-3 mt-2">

        <div class="col-md-3">
          <small class="text-muted">Created By</small>
          <div>
            <%= purchase.createdBy?.fullName || '-' %>
          </div>
        </div>

        <div class="col-md-3">
          <small class="text-muted">Created At</small>
          <div>
            <%= new Date(purchase.createdAt).toLocaleString('en-IN', {
                timeZone: 'Asia/Kolkata',
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                hour12: true
              }).replace('am', 'AM').replace('pm', 'PM') 
            %>
          </div>
        </div>

        <div class="col-md-3">
          <small class="text-muted">Updated By</small>
          <div>
            <%= purchase.updatedBy?.fullName || '-' %>
          </div>
        </div>

        <div class="col-md-3">
          <small class="text-muted">Updated At</small>
          <div>
            <%= purchase.updatedAt 
                  ? new Date(purchase.updatedAt).toLocaleString('en-IN', {
                      timeZone: 'Asia/Kolkata',
                      day: '2-digit',
                      month: '2-digit',
                      year: 'numeric',
                      hour: '2-digit',
                      minute: '2-digit',
                      second: '2-digit',
                      hour12: true
                    }).replace('am', 'AM').replace('pm', 'PM')
                  : '-' %>
          </div>
        </div>

      </div>

      <hr>

      <div class="row g-3">

        <div class="col-md-3">
          <small class="text-muted">Vendor</small>
          <div class="fw-semibold"><%= purchase.vendor?.name || '-' %></div>
        </div>

        <div class="col-md-2">
          <small class="text-muted">Delivery Schedule</small>
          <div><%= purchase.deliverySchedule || '-' %></div>
        </div>

        <div class="col-md-2">
          <small class="text-muted">Delivery At</small>
          <div>
            <span class="badge bg-light text-dark border">
              <%= purchase.deliveryAt || '-' %>
            </span>
          </div>
        </div>

        <div class="col-md-2">
          <small class="text-muted">Purchase Date</small>
          <div>
            <%= new Date(purchase.purchaseDate).toLocaleDateString('en-IN',{
              day: '2-digit',
              month: '2-digit',
              year: 'numeric'
            }) %>
          </div>
        </div>

        <div class="col-md-3">
          <small class="text-muted">Total PO Amount</small>
          <div class="fw-bold text-success">
            ₹<%= Number(purchase.totalAmount || 0).toFixed(2) %>
          </div>
        </div>

      </div>

    </div>
  </div>

  <!-- 🔷 PURCHASE ITEMS TABLE -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">

      <h5 class="mb-3">Ordered Items</h5>

      <div class="table-responsive">
        <table class="table table-bordered table-sm align-middle">

          <thead class="table-light">
            <tr>
              <th>Type</th>
              <th>Item</th>
              <th>Category</th>
              <th>Color</th>
              <th>Qty</th>
              <th>Base</th>
              <th>Rate</th>
              <th>GST</th>
              <th>Total</th>
            </tr>
          </thead>

          <tbody>
            <% (purchase.items || []).forEach(item => { %>
              <tr>

                <td>
                  <span class="badge <%= item.itemType === 'chair' ? 'bg-primary' : 'bg-secondary' %>">
                    <%= item.itemType === 'chair' ? 'Chair' : 'Spare' %>
                  </span>
                </td>

                <td>
                  <%= item.itemType === 'chair'
                    ? item.chair?.modelName
                    : item.sparePart?.partName %>
                </td>

                <td>
                  <% if(item.itemType === 'sparePart') { %>
                    <%= item.sparePart?.category?.name || '-' %>
                  <% } else { %> - <% } %>
                </td>

                <td>
                  <% 
                    let colorName = '-';
                    if (item.itemType === 'chair' && item.chair?.colors) {
                      const found = item.chair.colors.find(
                        c => c._id.toString() === item.chairColor?.toString()
                      );
                      if (found) colorName = found.name;
                    }
                  %>
                  <%= colorName %>
                </td>

                <td><%= item.quantity %></td>
                <td>₹<%= Number(item.basePrice || 0).toFixed(2) %></td>
                <td>₹<%= Number(item.finalRate || item.unitCost || 0).toFixed(2) %></td>

                <td>
                  <% if(item.gstApplicable) { %>
                    <span class="badge bg-info text-white">18% GST</span>
                  <% } else { %>
                    <span class="badge bg-secondary">No GST</span>
                  <% } %>
                </td>

                <td class="fw-bold text-success">
                  ₹<%= Number(item.totalCost || 0).toFixed(2) %>
                </td>

              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div class="d-flex justify-content-end mt-3">
        <div style="min-width: 260px;">
          <table class="table table-sm mb-0">
            <tr>
              <td class="text-muted">Total PO Items</td>
              <td class="text-end fw-semibold">
                <%= purchase.items?.length || 0 %>
              </td>
            </tr>
            <tr>
              <td class="text-muted">Total PO Amount</td>
              <td class="text-end fw-bold text-success">
                ₹<%= Number(purchase.totalAmount || 0).toFixed(2) %>
              </td>
            </tr>
          </table>
        </div>
      </div>

    </div>
  </div>

  <!-- 🔷 RECEIVED ITEMS TABLE -->
  <% if (purchase.receivedItems && purchase.receivedItems.length > 0) { %>
    <div class="card shadow-sm mb-4">
      <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="mb-0">Received Items</h5>
          <div>
            <span class="text-muted me-2">Received Date:</span>
            <span class="fw-semibold">
              <%= purchase.receivedAt 
                ? new Date(purchase.receivedAt).toLocaleDateString('en-IN', {
                    day: '2-digit',
                    month: '2-digit',
                    year: 'numeric'
                  }) 
                : '-' %>
            </span>
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-bordered table-sm align-middle mb-0">

            <thead class="table-light">
              <tr>
                <th>Type</th>
                <th>Item</th>
                <th>Category</th>
                <th>Color</th>
                <th class="text-center">Ordered Qty</th>
                <th class="text-center">Received Qty</th>
                <th class="text-center">Diff</th>
                <th>Unit Cost</th>
                <th>Total Cost</th>
                <th class="text-center">Match Status</th>
              </tr>
            </thead>

            <tbody>
              <% purchase.receivedItems.forEach(item => { %>
                <tr>

                  <td>
                    <span class="badge <%= item.itemType === 'chair' ? 'bg-primary' : 'bg-secondary' %>">
                      <%= item.itemType === 'chair' ? 'Chair' : 'Spare' %>
                    </span>
                  </td>

                  <td>
                    <%= item.itemType === 'chair'
                      ? (item.chair?.modelName || item.chair)
                      : (item.sparePart?.partName || item.sparePart) %>
                  </td>

                  <td>
                    <% if(item.itemType === 'sparePart') { %>
                      <%= item.sparePart?.category?.name || '-' %>
                    <% } else { %> - <% } %>
                  </td>

                  <td>
                    <% 
                      let colorName = '-';
                      if (item.itemType === 'chair' && item.chair?.colors) {
                        const found = item.chair.colors.find(
                          c => c._id.toString() === item.chairColor?.toString()
                        );
                        if (found) colorName = found.name;
                      }
                    %>
                    <%= colorName %>
                  </td>

                  <td class="text-center"><%= item.orderedQuantity %></td>
                  <td class="text-center fw-bold"><%= item.receivedQuantity %></td>

                  <td class="text-center">
                    <% if (item.difference === 0) { %>
                      <span class="text-muted">0</span>
                    <% } else if (item.difference > 0) { %>
                      <span class="text-danger fw-semibold">+<%= item.difference %></span>
                    <% } else { %>
                      <span class="text-danger fw-semibold"><%= item.difference %></span>
                    <% } %>
                  </td>

                  <td>₹<%= Number(item.unitCost || 0).toFixed(2) %></td>

                  <td class="fw-bold text-success">
                    ₹<%= Number(item.totalCost || 0).toFixed(2) %>
                  </td>

                  <td class="text-center">
                    <span class="badge 
                      <%= item.matchStatus === 'MATCHED' ? 'bg-success' :
                          item.matchStatus === 'QUANTITY_MISMATCH' ? 'bg-warning text-dark' :
                          'bg-danger' %>">
                      <%= item.matchStatus ? item.matchStatus.replace(/_/g, ' ') : '-' %>
                    </span>
                  </td>

                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="d-flex justify-content-end mt-3">
          <div style="min-width: 260px;">
            <table class="table table-sm mb-0">
              <tr>
                <td class="text-muted">Total Received Items Amount</td>
                <td class="text-end fw-bold text-success">
                  ₹<%= Number(purchase.receivedAmount || 0).toFixed(2) %>
                </td>
              </tr>
            </table>
          </div>
        </div>

        <% if (purchase.validationNotes) { %>
          <div class="mt-3">
            <small class="text-muted d-block mb-1">Validation Notes</small>
            <div class="border rounded p-2 bg-light small">
              <%= purchase.validationNotes %>
            </div>
          </div>
        <% } %>

      </div>
    </div>
  <% } %>

  <!-- 🔷 NOTES -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">

      <h5 class="mb-3">Notes</h5>

      <% if(purchase.notes) { %>
        <div class="border rounded p-3 bg-light">
          <%= purchase.notes %>
        </div>
      <% } else { %>
        <p class="text-muted">No notes added.</p>
      <% } %>

    </div>
  </div>

  <!-- 🔷 ACTIONS -->
  <div class="d-flex justify-content-end gap-2">
    <a href="/purchasing/purchases/<%= purchase._id %>/edit" 
       class="btn btn-primary">
      Edit Purchase
    </a>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>